# Dependencies
node_modules/
# pnpm is pinned via packageManager and pnpm-lock.yaml is the lockfile of
# record. An npm install here would leave a second, competing lockfile.
package-lock.json

# Build output
.astro/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
.env
# Worker secrets for `astro dev` (see .dev.vars.example)
.dev.vars
# Wrangler's local state and the deploy-config redirect the adapter writes
.wrangler/
.env.local
.env.*.local
