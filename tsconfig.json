{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Required by @astrojs/react, as `astro add react` writes them: Astro's base
    // config sets only jsx: preserve, with no import source for the .tsx islands.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
