{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Required by @astrojs/react: Astro's base config points jsxImportSource at
    // "astro", which would break the .tsx islands.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
