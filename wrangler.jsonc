{
  // One Worker serving the site. Every page is prerendered to dist/client and
  // served as a static asset; no route runs as code today. The
  // @astrojs/cloudflare adapter generates the deployable config
  // (dist/server/wrangler.json) from this file at build time.
  //
  // Should a route ever need secrets, set them with `wrangler secret put`,
  // never commit them.
  "name": "wildferret-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist/client",
    // Astro prerenders a real file per route, so unknown paths should genuinely
    // 404 rather than rewrite to index.html. dist/client/404.html is built from
    // src/pages/404.astro.
    "not_found_handling": "404-page",
  },
}
