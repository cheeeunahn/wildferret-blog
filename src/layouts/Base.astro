---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle'
import LangSwitcher from '../components/LangSwitcher.astro'
import {
  HTML_LANGS,
  LANGS,
  canonicalPath,
  isActiveInLocale,
  localeHref,
  toLangFreePath,
  type Lang,
  type Locale,
} from '../shared/i18n'
import { t } from '../copy/strings'
import { resolveAssetUrl } from '../shared/assetUrl'
import { Text } from '@astryxdesign/core/Text'
import { TopNavItem } from '@astryxdesign/core/TopNav'

interface Props {
  locale: Locale
  title?: string
  description?: string
  /** Languages this page exists in; see LangSwitcher. */
  availableLangs?: Lang[]
}

const { locale, title, description, availableLangs = [...LANGS] } = Astro.props
const strings = t(locale.lang)

const pathname = Astro.url.pathname
// The same page's identity across the three trees: '/about', not '/en/about'.
const appPath = toLangFreePath(pathname)
const year = new Date().getFullYear()

// Korean is served at both '/' and '/kr/'; point both at the unprefixed URL so
// they are not indexed as two competing pages.
const canonical = canonicalPath(locale.lang, appPath)
---

<!doctype html>
<!-- data-astryx-theme scopes the wildferret Astryx theme (src/styles/astryx/) to
     the whole page, so every Astryx component, and the h1–h6/p typography the
     theme sets, applies everywhere. See docs/adr/0002-astryx-design-system.md. -->
<!-- The page-wide base styles are utilities on <html> and <body>: Astryx's
     reset already handles margins and font smoothing, so what is left is the
     family, the ground and ink colours, smooth scrolling and selection colour.
     overscroll-y-none stops the trackpad's rubber-band bounce, which shook the
     whole page (sticky header included) even when it had nothing to scroll.
     Only for a fine pointer: on touch screens the same property would also
     switch off pull-to-refresh. -->
<html
  lang={HTML_LANGS[locale.lang]}
  data-astryx-theme="wildferret"
  class="font-body text-ink-900 bg-paper scroll-smooth motion-reduce:scroll-auto pointer-fine:overscroll-y-none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={resolveAssetUrl('/favicon.svg')} />
    <title>{title ?? strings.siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {
      /* canonicalPath, not switchLangHref: an hreflang alternate has to name the
         canonical URL for that language, so Korean points at '/', not '/kr'. */
      LANGS.filter((lang) => availableLangs.includes(lang)).map((lang) => (
        <link rel="alternate" hreflang={lang} href={canonicalPath(lang, appPath)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonicalPath('ko', appPath)} />

    <!-- Resolve the theme before first paint so there is no light flash.
         is:inline keeps Astro from bundling and deferring this. -->
    <script is:inline>
      ;(function () {
        try {
          var saved = localStorage.getItem('theme')
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches
          if (dark) document.documentElement.classList.add('dark')
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
          // Astryx's reset.css keys color-scheme off this attribute
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        } catch (e) {}
      })()
    </script>
    <link rel="preconnect" href="https://hangeul.pstatic.net" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body class="selection:bg-accent-soft selection:text-ink-950">
    <div class="min-h-screen flex flex-col">
      <header class="sticky top-0 z-50 bg-paper/80 backdrop-blur-md border-b border-ink-100">
        <nav class="max-w-[768px] mx-auto px-6 h-16 flex items-center justify-between gap-3 max-[359px]:gap-1">
          {/* Every internal link goes through localeHref, so a reader who
              arrived under /en stays under /en for the rest of the visit. */}
          <a
            href={localeHref(locale, '/')}
            class="text-ink-900 text-base sm:text-lg font-semibold tracking-tight whitespace-nowrap no-underline hover:opacity-70 transition-opacity"
          >
            {/* On phones (below sm) the English nav ("Posts", "About") leaves
                no room for the full name — it pushed the theme toggle past the
                screen edge at 390px — so the logo drops "'s blog" there, in
                every language so the logo does not change with the switcher. */}
            wildferret<span class="max-sm:hidden">'s blog</span>
          </a>
          {/* Every item on the right is the same 36px, 8px-radius box with its
              own side padding (TopNavItem, the language trigger, the theme
              toggle), so the gap between boxes stays small: the padding
              already spaces the labels.
              whitespace-nowrap: on a 320px phone the row is tight, and without
              it "소개" breaks onto two lines instead of the gaps giving way.
              Below sm the gaps go to zero (and the logo shortens, see above),
              and under 360px the nav items' padding and the gap after the logo
              shrink too: on a 320px screen the English row ("Posts", "About")
              is otherwise 24px too wide and pushes the theme toggle off. */}
          <div class="flex items-center sm:gap-1 whitespace-nowrap">
            <TopNavItem
              href={localeHref(locale, '/')}
              label={strings.nav.posts}
              isSelected={isActiveInLocale(pathname, '/')}
              className="max-[359px]:px-1.5!"
            />
            <TopNavItem
              href={localeHref(locale, '/about')}
              label={strings.nav.about}
              isSelected={isActiveInLocale(pathname, '/about')}
              className="max-[359px]:px-1.5!"
            />
            <LangSwitcher locale={locale} appPath={appPath} availableLangs={availableLangs} />
            <!-- client:only — ThemeToggle reads document.documentElement in a
                 useState initializer, which has no server equivalent. The fixed
                 36px box (the button's own size-9) reserves its space so the
                 header does not shift when the island mounts. -mr-2 pulls the
                 icon out to the page edge, as its box is padding the icon
                 does not fill. -->
            <span class="inline-flex size-9 items-center justify-center -mr-2">
              <ThemeToggle
                client:only="react"
                toLight={strings.theme.toLight}
                toDark={strings.theme.toDark}
              />
            </span>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      {/* One quiet row: the tagline and the copyright, 24px of padding, in
          Astryx's xsm size (11px), one step below the supporting type. The
          name is not repeated above the tagline, since the copyright already
          carries it. On phones the two lines stack, with a small gap. */}
      <footer class="border-t border-ink-100 bg-paper-warm">
        <div class="max-w-[768px] mx-auto px-6 py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4">
          <Text as="p" display="block" type="supporting" size="xsm">
            Just another product IT startup person out there, in the wild!
          </Text>
          <Text as="p" display="block" type="supporting" size="xsm" className="shrink-0">
            &copy; {year} wildferret
          </Text>
        </div>
      </footer>
    </div>
  </body>
</html>
