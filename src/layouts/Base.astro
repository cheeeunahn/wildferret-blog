---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle'
import LangSwitcher from '../components/LangSwitcher.astro'
import PageContainer from '../components/PageContainer.astro'
import {
  HTML_LANGS,
  LANGS,
  canonicalPath,
  isActiveInLocale,
  localeHref,
  toLangFreePath,
  type Lang,
  type Locale,
} from '../shared/i18n'
import { t } from '../copy/strings'
import { resolveAssetUrl } from '../shared/assetUrl'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
  title?: string
  description?: string
  /** Languages this page exists in; see LangSwitcher. */
  availableLangs?: Lang[]
}

const { locale, title, description, availableLangs = [...LANGS] } = Astro.props
const strings = t(locale.lang)

const pathname = Astro.url.pathname
// The same page's identity across the three trees: '/about', not '/en/about'.
const appPath = toLangFreePath(pathname)
const year = new Date().getFullYear()

// Korean is served at both '/' and '/kr/'; point both at the unprefixed URL so
// they are not indexed as two competing pages.
const canonical = canonicalPath(locale.lang, appPath)

const navLinkClass = (path: string) =>
  `nav-link ${isActiveInLocale(pathname, path) ? 'nav-link-active' : ''}`
---

<!doctype html>
<!-- data-astryx-theme scopes the wildferret Astryx theme (src/styles/astryx/) to
     the whole page, so every Astryx component, and the h1–h6/p typography the
     theme sets, applies everywhere. See docs/adr/0002-astryx-design-system.md. -->
<html lang={HTML_LANGS[locale.lang]} data-astryx-theme="wildferret">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={resolveAssetUrl('/favicon.svg')} />
    <title>{title ?? strings.siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {
      /* canonicalPath, not switchLangHref: an hreflang alternate has to name the
         canonical URL for that language, so Korean points at '/', not '/kr'. */
      LANGS.filter((lang) => availableLangs.includes(lang)).map((lang) => (
        <link rel="alternate" hreflang={lang} href={canonicalPath(lang, appPath)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonicalPath('ko', appPath)} />

    <!-- Resolve the theme before first paint so there is no light flash.
         is:inline keeps Astro from bundling and deferring this. -->
    <script is:inline>
      ;(function () {
        try {
          var saved = localStorage.getItem('theme')
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches
          if (dark) document.documentElement.classList.add('dark')
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
          // Astryx's reset.css keys color-scheme off this attribute
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        } catch (e) {}
      })()
    </script>
    <link rel="preconnect" href="https://hangeul.pstatic.net" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gaegu:wght@300;400;700&display=swap"
    />
  </head>
  <body>
    {/* boot-shell / boot-header are deliberately not applied: they were
        once-per-SPA-boot animations and would replay on every real navigation.
        Per-page entrance motion lives on each page's .page-enter wrapper. */}
    <div class="min-h-screen flex flex-col">
      {/* Plain top bar, after the Astryx docs examples: body background and a
          hairline, no blur. 56px on phones, 64px from sm — the home filter bar
          sticks at that same offset (.cat-bar). */}
      <header class="site-header sticky top-0 z-50 bg-paper border-b border-ink-100">
        <PageContainer
          as="nav"
          width="wide"
          class="h-14 sm:h-16 flex items-center justify-between gap-2"
        >
          {/* Every internal link goes through localeHref, so a reader who
              arrived under /en stays under /en for the rest of the visit. */}
          <a
            href={localeHref(locale, '/')}
            class="site-logo text-ink-900 text-base sm:text-lg font-semibold tracking-tight no-underline hover:opacity-70 transition-opacity"
          >
            {/* The brand is a name, not chrome copy, so it is not translated.
                Phones under 400px get the short form so the nav still fits. */}
            <span class="site-logo-long">wildferret's blog</span>
            <span class="site-logo-short" aria-hidden="true">
              wildferret
            </span>
          </a>
          <div class="flex items-center gap-1 sm:gap-3">
            <a
              href={localeHref(locale, '/')}
              class={navLinkClass('/')}
              aria-current={isActiveInLocale(pathname, '/') ? 'page' : undefined}
            >
              {strings.nav.posts}
            </a>
            <a
              href={localeHref(locale, '/about')}
              class={navLinkClass('/about')}
              aria-current={isActiveInLocale(pathname, '/about') ? 'page' : undefined}
            >
              {strings.nav.about}
            </a>
            <LangSwitcher locale={locale} appPath={appPath} availableLangs={availableLangs} />
            <!-- client:only — ThemeToggle reads document.documentElement in a
                 useState initializer, which has no server equivalent. The fixed
                 44px box (a full tap target) reserves its space so the header
                 does not shift when the island mounts. -->
            <span class="inline-flex w-11 h-11 items-center justify-center -mr-2.5">
              <ThemeToggle client:only="react" />
            </span>
          </div>
        </PageContainer>
      </header>

      {/* Closes the language <details> menu on an outside click or Escape — the
          two things a native <details> does not do by itself. Inline and
          dependency-free, like the hero script: not a hydrated island. */}
      <script is:inline>
        ;(() => {
          const close = (except) =>
            document.querySelectorAll('details.lang-menu[open]').forEach((d) => {
              if (d !== except) d.removeAttribute('open')
            })
          document.addEventListener('click', (e) => close(e.target.closest('details.lang-menu')))
          document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return
            const open = document.querySelector('details.lang-menu[open]')
            if (!open) return
            open.removeAttribute('open')
            open.querySelector('summary')?.focus()
          })
        })()
      </script>
      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-ink-100 bg-paper-warm">
        <PageContainer
          width="wide"
          class="site-footer-inner py-10 sm:py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        >
          <div class="flex flex-col gap-1">
            <Text as="p" display="block" type="label" weight="bold">
              wildferret
            </Text>
            <Text as="p" display="block" type="supporting">
              Just another product IT startup person out there, in the wild!
            </Text>
          </div>
          <Text as="p" display="block" type="supporting">
            &copy; {year} wildferret
          </Text>
        </PageContainer>
      </footer>
    </div>
  </body>
</html>
