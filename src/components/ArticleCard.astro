---
import type { LocalizedArticle } from '../content/service'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'
import { resolveAssetUrl } from '../shared/assetUrl'
import { ClickableCard } from '@astryxdesign/core/ClickableCard'
import { Heading } from '@astryxdesign/core/Heading'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  article: LocalizedArticle
  index: number
  locale: Locale
}

const { article, index, locale } = Astro.props
const strings = t(locale.lang)
---

{/* A library tile: artwork bled to the card's top edge, text below. The
    wrapper is the grid item, so h-full lets every card in a row share one
    height. Astryx's ClickableCard renders a real <a href>, but visually hidden
    (1px, clipped): a click on the card surface navigates through a React
    onClick, which never ships here because the card is static HTML. So the
    [&>a] utilities undo that hiding and stretch the anchor over the whole card
    — one real link, Astryx's own label and focus target, no JS. They need `!`
    to beat StyleX's high-specificity selectors. data-search is what the CategoryFilter island matches the query against —
    our own content, never reader input. Once the reader has filtered, a card
    coming back replays its entrance with no stagger (in-data-filtered). */}
<div
  class="group h-full animate-reveal in-data-filtered:[animation-delay:0s]!"
  data-cat={article.category}
  data-search={`${article.title} ${article.subtitle}`}
  style={`animation-delay: ${0.4 + index * 0.06}s`}
>
  <article class="h-full">
    <ClickableCard
      href={localeHref(locale, `/article/${article.slug}`)}
      label={article.title}
      padding={0}
      className="h-full overflow-hidden flex flex-col [&>a]:inset-0! [&>a]:size-auto! [&>a]:m-0! [&>a]:[clip:auto]! [&>a]:z-1!"
    >
      {/* Every card gets the same 4:3 plate, so a post without artwork keeps
          the row's rhythm instead of collapsing to a text-only tile. The
          covers are square line art, so they are contained (with a little
          inset) rather than cropped to the frame, which cut off their edges.
          They are black on white and are shown as drawn, so the
          plate is the same white in both themes; a post with no artwork gets a
          quiet muted plate instead, which would otherwise read as a missing
          image. */}
      <div
        class={`aspect-[4/3] overflow-hidden ${article.cardImage ? 'bg-thumb-plate' : 'bg-ink-50'}`}
      >
        {article.cardImage ? (
          <img
            src={resolveAssetUrl(article.cardImage)}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-contain p-2 transition-transform duration-[350ms] group-hover:scale-[1.04] dark:filter-none"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
            <Text type="supporting">{article.category}</Text>
          </div>
        )}
      </div>

      <div class="flex flex-1 flex-col gap-1.5 p-5">
        <Text type="supporting">{article.category}</Text>
        {/* break-keep: Korean wraps between words, as it does in articles,
            instead of splitting one ("요 / 약해보기"). text-pretty keeps a
            single word from being stranded on the title's last line. */}
        <Heading
          level={3}
          className="break-keep text-pretty group-hover:text-ink-600 transition-colors"
        >
          {article.title}
        </Heading>
        <Text
          as="p"
          display="block"
          color="secondary"
          maxLines={2}
          hasTruncateTooltip={false}
          className="break-keep"
        >
          {article.subtitle}
        </Text>
        {/* mt-auto pins the meta to the card's foot, so dates line up across a
            row whatever the title length. */}
        <div class="mt-auto pt-3">
          <Text type="supporting">
            {article.date} · {strings.article.readTime(article.readMinutes)}
          </Text>
        </div>
      </div>
    </ClickableCard>
  </article>
</div>
