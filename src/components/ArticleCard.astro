---
import type { Article } from '../data/articleTypes'
import { href } from '../lib/siteUrl'

interface Props {
  article: Article
  index: number
}

const { article, index } = Astro.props
---

<a
  href={href(`/article/${article.slug}`)}
  class="group block no-underline animate-reveal"
  style={`animation-delay: ${0.4 + index * 0.08}s`}
>
  <article
    class="py-8 sm:py-10 border-b border-ink-100 transition-colors hover:bg-ink-50/50 -mx-6 px-6"
  >
    {/* Meta */}
    <div class="text-xs text-ink-500 mb-3">{article.date}</div>

    {/* Title */}
    <h2
      class="text-xl sm:text-[22px] font-semibold text-ink-900 leading-snug tracking-tight mb-2 group-hover:text-ink-600 transition-colors"
    >
      {article.title}
    </h2>

    {/* Subtitle */}
    <p class="text-[15px] text-ink-600 leading-relaxed line-clamp-2">
      {article.subtitle}
    </p>

    {/* Read time */}
    <div class="mt-4 flex items-center gap-2 text-xs text-ink-500">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      {article.readTime} 읽기
    </div>
  </article>
</a>
