---
import type { LocalizedArticle } from '../content/service'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'
import { resolveAssetUrl } from '../shared/assetUrl'
import { Badge } from '@astryxdesign/core/Badge'
import { Card } from '@astryxdesign/core/Card'
import { Heading } from '@astryxdesign/core/Heading'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  article: LocalizedArticle
  index: number
  locale: Locale
}

const { article, index, locale } = Astro.props
const strings = t(locale.lang)
---

<a
  href={localeHref(locale, `/article/${article.slug}`)}
  class="group block h-full no-underline animate-reveal"
  data-cat={article.category}
  style={`animation-delay: ${0.4 + index * 0.08}s`}
>
  {/* One component, two shapes, after the Astryx "Card Grid" example. From sm
      it is the grid card: thumbnail on top, then title, subtitle and meta. On
      phones it is a compact row, a 96px square beside the text, so a list of
      posts stays scannable instead of each card filling the screen.
      Astryx Card, rendered to static HTML; the layout stays in utilities
      because it changes at the sm breakpoint. */}
  <article class="h-full">
    <Card padding={0} className="article-card h-full p-3 flex flex-row sm:flex-col gap-4 sm:gap-0">
      <div class="article-thumb shrink-0 overflow-hidden rounded-lg w-24 h-24 sm:w-full sm:h-auto sm:aspect-[16/10]">
        <img
          src={resolveAssetUrl(article.cardImage)}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover sm:object-contain"
        />
      </div>

      <div class="min-w-0 flex-1 flex flex-col sm:px-1 sm:pt-4 sm:pb-1">
        <Heading level={4} className="card-title mb-1.5 group-hover:text-ink-600 transition-colors">
          {article.title}
        </Heading>

        <Text
          as="p"
          display="block"
          type="supporting"
          color="secondary"
          maxLines={2}
          hasTruncateTooltip={false}
        >
          {article.subtitle}
        </Text>

        {/* Meta. mt-auto pins it to the bottom, so a row of cards with
            different-length titles still lines their meta up. Gaps, not "·"
            separators: on a narrow card the row wraps, and a separator would
            be left dangling at the end of the first line. */}
        <div class="mt-auto pt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <Text type="supporting">{article.date}</Text>
          <Badge variant="blue" label={article.category} />
          <Text type="supporting">{strings.article.readTime(article.readMinutes)}</Text>
        </div>
      </div>
    </Card>
  </article>
</a>
