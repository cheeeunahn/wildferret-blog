---
import ArticleCard from './ArticleCard.astro'
import CategoryFilter from './CategoryFilter'
import { articlesIn, CATEGORIES } from '../content/service'
import { t } from '../copy/strings'
import type { Locale } from '../shared/i18n'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale.lang)

// Only posts written in this language. A post with no version here is left out
// rather than shown as untranslated Korean.
const articles = articlesIn(locale.lang)

// Only offer a pill for a category that actually has articles, in the fixed
// CATEGORIES order rather than in publication order.
const usedCategories = CATEGORIES.filter((c) => articles.some((a) => a.category === c))

// The filter's screen-reader count, one label per possible result (1…n), since
// the island cannot take strings.home.resultsCount itself as a prop.
const resultLabels = articles.map((_, i) => strings.home.resultsCount(i + 1))
---

<div class="animate-page-enter">
  {/* Category filter + article list, laid out like Astryx's Library
      template minus its titled header (the nav tab already says 글 / Posts):
      a full-width search, category pills, then a grid of image-topped cards.
      The island hides cards by setting `hidden` inside this element, so they
      must all stay within it. */}
  <div class="cat-scope pt-10 sm:pt-12">
    {/* The toolbar sticks below the header so it stays reachable while you
        scroll the list — top-16 is the header's own h-16, and z-40 keeps it
        under the header rather than sliding over it. The band is full-bleed
        and only the inner section is width-capped, so the cards pass behind an
        opaque strip. The sentinel sits one pixel above it in normal flow (it
        needs a real box to be observable, hence h-px) and tells the script
        below when the bar has stuck: observing the bar itself would never
        fire, since a stuck element never leaves view.
        No shadow at rest — the bar is the same ground as the page until it
        actually lifts off it. In dark a soft shadow on a near-black page is
        invisible, so it takes Astryx's heaviest one instead. */}
    <div class="cat-sentinel h-px" aria-hidden="true"></div>
    <div class="cat-bar sticky top-16 z-40 bg-paper py-5 transition-shadow duration-200 motion-reduce:transition-none data-stuck:shadow-med dark:data-stuck:shadow-high">
      <section class="max-w-[720px] mx-auto px-6 animate-reveal reveal-delay-3">
        {/* client:load, not :visible — the toolbar is near the top of the page
            and sticky, so it is on screen almost at once. */}
        <CategoryFilter
          client:load
          categories={usedCategories}
          allLabel={strings.home.filterAll}
          legend={strings.home.filterLegend}
          searchLabel={strings.home.searchLabel}
          searchPlaceholder={strings.home.searchPlaceholder}
          noMatches={strings.home.noMatches}
          resultLabels={resultLabels}
        />
      </section>
    </div>

    {/* Same idiom as FerretHero's script: inline, dependency-free, not a hydrated
        component (see the islands policy in CLAUDE.md). There is no CSS
        selector for "is currently stuck", so this is the one job that needs
        script. If it never runs the bar still sticks — it just does not gain
        the shadow. */}
    <script is:inline>
      ;(() => {
        const bar = document.querySelector('.cat-bar')
        const sentinel = document.querySelector('.cat-sentinel')
        if (!bar || !sentinel || !('IntersectionObserver' in window)) return
        new IntersectionObserver(
          ([entry]) => bar.toggleAttribute('data-stuck', !entry.isIntersecting),
          // The header is 64px of fixed chrome over the viewport; shrink the
          // root by that much so the sentinel counts as gone when it slides
          // under the header, not when it leaves the screen entirely.
          { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
        ).observe(sentinel)
      })()
    </script>
    <div class="max-w-[720px] mx-auto px-6 pb-20">
      {articles.length > 0 ? (
        <>
          {/* One grid rather than the template's per-category sections: with a
              handful of posts spread over the categories, sections would each
              hold a single card. The pills narrow this grid instead. Two
              columns at most: the page is a 720px column, and three would
              squeeze each card to ~208px. gap-6 matches the page's own 24px
              side margin. */}
          <div class="border-t border-ink-100 pt-6 grid gap-6 sm:grid-cols-2">
            {articles.map((article, i) => (
              <ArticleCard article={article} index={i} locale={locale} />
            ))}
          </div>
          <p class="cat-empty pt-6" hidden>
            <Text color="secondary">{strings.home.noMatches}</Text>
          </p>
        </>
      ) : (
        <Text as="p" display="block" color="secondary" className="animate-reveal reveal-delay-4">
          {strings.home.emptyList}
        </Text>
      )}
    </div>
  </div>
</div>
