---
import ArticleCard from './ArticleCard.astro'
import CategoryFilter from './CategoryFilter'
import PageContainer from './PageContainer.astro'
import { articlesIn, CATEGORIES } from '../content/service'
import { resolveAssetUrl } from '../shared/assetUrl'
import { t } from '../copy/strings'
import type { Locale } from '../shared/i18n'
import { Grid } from '@astryxdesign/core/Grid'
import { Heading } from '@astryxdesign/core/Heading'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale.lang)

// Only posts written in this language. A post with no version here is left out
// rather than shown as untranslated Korean.
const articles = articlesIn(locale.lang)

// Only offer a pill for a category that actually has articles, in the fixed
// CATEGORIES order rather than in publication order.
const usedCategories = CATEGORIES.filter((c) => articles.some((a) => a.category === c))

// The hero's later frames: same ferret, turned to face the reader, then
// greeting them properly. Stepped through by the radio group below.
const GREET_FRAMES = [
  {
    src: '/assets/images/wildferret-hero-greeting.webp',
    alt: strings.home.heroGreetAlt,
  },
  {
    src: '/assets/images/wildferret-hero-greeting-2.webp',
    alt: strings.home.heroGreetMoreAlt,
  },
]

// The CategoryFilter island writes the chosen category to .cat-scope's
// data-filter; these rules hide the cards of other categories, so the cards
// stay static HTML. One rule per category, generated from the data so adding a category to
// articleTypes.ts is the only edit needed. Category names are our own data,
// never reader input.
const filterCss = usedCategories
  .map((c) => `.cat-scope[data-filter="${c}"] [data-cat]:not([data-cat="${c}"]){display:none}`)
  .join('\n')
---

<div class="page-enter">
  {/* Hero, after the Astryx "Documentation Catalog" example: one panel with
      the site's title and a line about it, beside the illustration.
      The panel is surface-on-body with a hairline rather than a muted tint —
      Astryx's muted background is translucent and all but vanishes in dark
      mode. Phones and tablets stack it with the illustration on top; from lg
      the copy sits on the left. */}
  <PageContainer as="section" width="wide" class="pt-4 sm:pt-8">
    <div class="hero-panel grid items-center gap-5 sm:gap-8 p-3 sm:p-6 lg:p-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="order-2 lg:order-1 px-1 pb-2 sm:px-2 lg:pb-0 animate-reveal delay-2">
        <Heading level={1} type="display-2" className="display-title mb-3">
          {strings.siteTitle}
        </Heading>
        <Text as="p" display="block" type="large" color="secondary" className="hero-tagline">
          {strings.siteDescription}
        </Text>
      </div>

      {/* The illustration and everything in it — the greeting cycle, the
          fireflies, the sound toggle and the script below — is unchanged;
          only its frame moved into the panel. */}
      <figure class="order-1 lg:order-2 m-0 animate-reveal-media delay-1">
        <div class="hero-greet relative block overflow-hidden rounded-xl bg-paper-warm/30">
          <input
            type="radio"
            name="hero-state"
            id="hero-s0"
            class="hero-state sr-only"
            checked
            aria-label={strings.home.heroStateIdle}
          />
          <input
            type="radio"
            name="hero-state"
            id="hero-s1"
            class="hero-state sr-only"
            aria-label={strings.home.heroStateGreet}
          />
          <input
            type="radio"
            name="hero-state"
            id="hero-s2"
            class="hero-state sr-only"
            aria-label={strings.home.heroStateGreetMore}
          />

          <img
            src={resolveAssetUrl('/assets/images/wildferret-hero-coding.webp')}
            alt={strings.home.heroCodingAlt}
            class="w-full h-[260px] sm:h-[400px] object-cover object-[62%_38%]"
            loading="eager"
          />
          {GREET_FRAMES.map((frame, i) => (
            <img
              src={resolveAssetUrl(frame.src)}
              alt={frame.alt}
              class={`hero-frame hero-frame-${i + 1} absolute inset-0 w-full h-full object-cover object-[62%_38%]`}
              loading="eager"
            />
          ))}

          {/* Fireflies. Decorative and click-through (pointer-events: none in
            global.css), so they sit above the frames but below the labels
            and never block the greeting. Each one carries its own drift and
            pulse timing — see .hero-firefly-N. */}
          <div class="hero-fireflies" aria-hidden="true">
            {Array.from({ length: 7 }, (_, i) => (
              <span class={`hero-firefly hero-firefly-${i + 1}`} />
            ))}
          </div>

          {/* Only the label for the next state is displayed (see global.css),
            so clicking the same spot again advances the cycle. */}
          <label for="hero-s1" class="hero-step hero-step-1">
            <span class="sr-only">{strings.home.heroStepGreet}</span>
          </label>
          <label for="hero-s2" class="hero-step hero-step-2">
            <span class="sr-only">{strings.home.heroStepGreetMore}</span>
          </label>
          <label for="hero-s0" class="hero-step hero-step-0">
            <span class="sr-only">{strings.home.heroStepReset}</span>
          </label>

          {/* Room tone for the desk scene: office ambience with the ferret's
            own typing layered over it, started and stopped together. The two
            loops are different lengths (56s and 8s), so they drift against
            each other instead of repeating as one fixed bar.
            Off by default and preload="none", so nothing is fetched until a
            reader asks for it — and browsers block autoplay without a
            gesture anyway. The button sits above the step labels so it does
            not advance the greeting. */}
          <audio
            class="hero-audio"
            src={resolveAssetUrl('/assets/audio/office-ambience.mp3')}
            data-volume="0.35"
            loop
            preload="none"
          ></audio>
          <audio
            class="hero-audio"
            src={resolveAssetUrl('/assets/audio/keyboard-typing.mp3')}
            data-volume="0.22"
            loop
            preload="none"
          ></audio>
          {/* The two labels ride on the element rather than living in the
            script below: the script is is:inline and untranslated by design,
            so the only way it can speak the page's language is to read it
            off the DOM. */}
          <button
            type="button"
            class="hero-sound"
            aria-pressed="false"
            aria-label={strings.home.soundOn}
            data-label-on={strings.home.soundOn}
            data-label-off={strings.home.soundOff}
          >
            <svg
              class="hero-sound-icon hero-sound-off"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M11 5 6 9H3v6h3l5 4z" />
              <path d="m16 9 5 6" />
              <path d="m21 9-5 6" />
            </svg>
            <svg
              class="hero-sound-icon hero-sound-on"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M11 5 6 9H3v6h3l5 4z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7" />
              <path d="M18.5 5.5a9 9 0 0 1 0 13" />
            </svg>
          </button>
        </div>

        {/* Sits outside the frame rather than over the art: the illustration is
          busy at the bottom edge and an overlay would need a scrim to stay
          legible, which reads as a header band on a photo. Small and quiet —
          this labels the picture, it is not the page's headline. */}
        <figcaption class="mt-3 text-center">
          <Text type="supporting">{strings.home.heroCaption}</Text>
        </figcaption>
      </figure>

      {/* The one bit the CSS state machine cannot do: drop back to the idle
          frame when the reader stops clicking. Inline and dependency-free on
          purpose — see the islands policy in CLAUDE.md; this is not a
          hydrated component. */}
      <script is:inline>
        ;(() => {
          const idle = document.getElementById('hero-s0')
          if (idle) {
            const states = document.querySelectorAll('.hero-state')
            let timer
            states.forEach((input) => {
              input.addEventListener('change', () => {
                clearTimeout(timer)
                if (input === idle) return
                timer = setTimeout(() => {
                  idle.checked = true
                }, 6000)
              })
            })
          }

          // Sound toggle. aria-pressed is the single source of truth: the
          // CSS swaps the icon off it, so nothing can drift out of sync.
          const button = document.querySelector('.hero-sound')
          const tracks = [...document.querySelectorAll('.hero-audio')]
          if (!button || !tracks.length) return
          // Mixed here rather than in the files: typing sits under the room
          // tone, and both sit well under the page.
          tracks.forEach((track) => {
            track.volume = Number(track.dataset.volume || 0.3)
          })
          const setState = (on) => {
            button.setAttribute('aria-pressed', String(on))
            // Rendered per language into data-*; see the button's markup.
            const label = on ? button.dataset.labelOff : button.dataset.labelOn
            if (label) button.setAttribute('aria-label', label)
          }
          button.addEventListener('click', () => {
            if (button.getAttribute('aria-pressed') === 'true') {
              tracks.forEach((track) => track.pause())
              setState(false)
              return
            }
            setState(true)
            // play() rejects if the browser refuses the gesture; if any
            // layer is blocked, stop them all rather than showing sound
            // that is only half playing.
            Promise.all(tracks.map((track) => track.play())).catch(() => {
              tracks.forEach((track) => track.pause())
              setState(false)
            })
          })
        })()
      </script>
    </div>
  </PageContainer>

  {/* Category filter + article list. The filter rules key off .cat-scope's
      data-filter, so the cards must stay inside this one element. */}
  <div class="cat-scope pt-8 sm:pt-12">
    <style is:inline set:html={filterCss}></style>

    {/* The filter sticks below the header so it stays reachable while you
        scroll the list. Its top offset is the header's own height (h-14, then
        h-16 from sm), and z-40 keeps it under the header rather than sliding
        over it. The band is full-bleed and only the inner row is width-capped,
        so the cards pass behind an opaque strip.
        The sentinel is what tells us the bar has stuck: it sits one pixel
        above the sticky element in normal flow, so the moment it passes under
        the header the bar is at its stop. */}
    <div class="cat-sentinel" aria-hidden="true"></div>
    <div class="cat-bar sticky top-14 sm:top-16 z-40 bg-paper py-3 sm:py-4">
      <PageContainer
        width="wide"
        class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-6 animate-reveal delay-3"
      >
        <Heading level={2}>{strings.nav.posts}</Heading>
        {/* One row that scrolls sideways on phones rather than wrapping to two.
            client:load, not :visible — the bar is near the top of the page and
            sticky, so it is on screen almost at once. */}
        <div class="cat-chips min-w-0">
          <CategoryFilter
            client:load
            categories={usedCategories}
            allLabel={strings.home.filterAll}
            legend={strings.home.filterLegend}
          />
        </div>
      </PageContainer>
    </div>

    {/* Same idiom as the hero script: inline, dependency-free, not a hydrated
        component (see the islands policy in CLAUDE.md). There is no CSS
        selector for "is currently stuck", so this is the one job that needs
        script. If it never runs the bar still sticks — it just does not gain
        the shadow. */}
    <script is:inline>
      ;(() => {
        const bar = document.querySelector('.cat-bar')
        const sentinel = document.querySelector('.cat-sentinel')
        const header = document.querySelector('.site-header')
        if (!bar || !sentinel || !('IntersectionObserver' in window)) return
        // The header is fixed chrome over the viewport (56px on phones, 64px
        // from sm); shrink the root by its height so the sentinel counts as
        // gone when it slides under the header, not when it leaves the screen.
        const top = header ? header.offsetHeight : 64
        new IntersectionObserver(
          ([entry]) => bar.classList.toggle('is-stuck', !entry.isIntersecting),
          { rootMargin: `-${top}px 0px 0px 0px`, threshold: 0 },
        ).observe(sentinel)
      })()
    </script>
    <PageContainer width="wide" class="pt-2 pb-16 sm:pb-20">
      {/* One grid of every post, as in the Astryx "Documentation Catalog"
          example: one column on phones (compact row cards), then as many
          240px+ columns as fit, up to four. With only a handful of posts per
          category, per-category sections left each one a lone card. */}
      {articles.length > 0 ? (
        <Grid columns={{ minWidth: 240, max: 4 }} gap={5}>
          {articles.map((article, i) => (
            <ArticleCard article={article} index={Math.min(i, 8)} locale={locale} />
          ))}
        </Grid>
      ) : (
        <Text as="p" display="block" color="secondary" className="animate-reveal delay-4">
          {strings.home.emptyList}
        </Text>
      )}
    </PageContainer>
  </div>
</div>
