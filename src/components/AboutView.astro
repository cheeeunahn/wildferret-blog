---
import { resolveAssetUrl } from '../shared/assetUrl'
import { aboutCopy } from '../content/service'
import type { Locale } from '../shared/i18n'
import { Badge } from '@astryxdesign/core/Badge'
import { Heading } from '@astryxdesign/core/Heading'
import { HStack } from '@astryxdesign/core/HStack'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = aboutCopy(locale.lang)
const profileImageUrl = resolveAssetUrl('/assets/images/profile-ferret-desk.webp')
---

<div class="page-enter">
  <section class="max-w-[720px] mx-auto px-6 pt-10 sm:pt-14 pb-20">
    {/* Profile. Same 720px column as the header and footer, so the page shares
        their left edge; avatar beside the heading rather than stacked above. */}
    <HStack gap={5} align="center" className="animate-reveal mb-12">
      <div class="w-20 h-20 shrink-0 rounded-full border border-ink-200 overflow-hidden">
        <img
          src={profileImageUrl}
          alt={copy.profileAlt}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div>
        <Heading level={1} className="mb-2">
          {copy.heading}
        </Heading>
        <Text as="p" display="block" type="large" color="secondary">
          {copy.intro}
        </Text>
      </div>
    </HStack>

    {/* Interests */}
    <div class="animate-reveal delay-2">
      <Heading level={2} className="mb-6">
        {copy.interestsHeading}
      </Heading>
      <HStack gap={2} wrap="wrap">
        {copy.interests.map((interest) => (
          <Badge label={interest} />
        ))}
      </HStack>
    </div>

    {/* Career */}
    <div class="mt-16 animate-reveal delay-3">
      <Heading level={2} className="mb-6">
        {copy.careerHeading}
      </Heading>
      <ul class="space-y-3">
        {copy.career.map((item) => (
          <li class="flex flex-col sm:flex-row sm:gap-4 text-[15px]">
            <Text type="supporting" hasTabularNumbers className="sm:w-32 sm:shrink-0 sm:pt-1">
              {item.period}
            </Text>
            <Text>
              {item.role}
              <Text type="inherit" color="secondary">{` · ${item.org}`}</Text>
            </Text>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>
