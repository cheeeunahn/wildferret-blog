---
import { aboutCopy } from '../content/service'
import type { Locale } from '../shared/i18n'
import { Heading } from '@astryxdesign/core/Heading'
import { Icon } from '@astryxdesign/core/Icon'
import { Link } from '@astryxdesign/core/Link'
import { Text } from '@astryxdesign/core/Text'
import FerretHero from './FerretHero.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = aboutCopy(locale.lang)
---

<div class="animate-page-enter">
  <section class="max-w-[768px] mx-auto px-6 pt-10 sm:pt-14 pb-20 break-keep">
    {/* Profile. Same 768px column as the header and footer, so the page shares
        their left edge. break-keep on the whole section: Korean wraps between
        words, so a phone never splits a name ("안 / 치은") or a word in two. */}
    <div class="animate-reveal mb-12">
      <Heading level={1} className="mb-2 text-pretty">
        {copy.heading}
      </Heading>
      {/* whitespace-pre-line turns the intro's \n into a line break. */}
      <Text as="p" display="block" color="secondary" className="whitespace-pre-line">
        {copy.intro}
      </Text>
    </div>

    {/* Career */}
    <div class="animate-reveal reveal-delay-2">
      <Heading level={3} accessibilityLevel={2} className="mb-5">
        {copy.careerHeading}
      </Heading>
      <ul class="space-y-3">
        {copy.career.map((item) => (
          <li class="flex flex-col sm:flex-row sm:gap-4">
            <Text type="supporting" hasTabularNumbers className="sm:w-32 sm:shrink-0 sm:pt-0.5">
              {item.period}
            </Text>
            <Text type="compact">
              {item.role}
              <Text type="inherit" color="secondary">{` · ${item.org}`}</Text>
            </Text>
          </li>
        ))}
      </ul>
    </div>

    {/* Selected projects */}
    <div class="mt-16 animate-reveal reveal-delay-3">
      <Heading level={3} accessibilityLevel={2} className="mb-5">
        {copy.projectsHeading}
      </Heading>
      <ul class="space-y-4">
        {copy.projects.map((project) => (
          <li class="flex flex-col sm:flex-row sm:gap-4">
            <Text type="supporting" hasTabularNumbers className="sm:w-32 sm:shrink-0 sm:pt-1">
              {project.year}
            </Text>
            <div>
              {/* Body-colored title, underlined only on hover, with a small
                  external-link glyph (decorative, aria-hidden) marking it as
                  a link off the site. It opens in the same tab: a new tab would
                  need a translated "(opens in new tab)" label per language.
                  The interviews list below renders its titles the same way.
                  The rows use the theme's compact type (15px), which the link
                  takes from the row's Text (type="inherit"). */}
              <Text as="p" display="block" type="compact">
                {project.link ? (
                  <Link href={project.link} color="primary" type="inherit">
                    {project.name}
                    <Icon icon="externalLink" size="xsm" color="secondary" className="ml-1" />
                  </Link>
                ) : (
                  project.name
                )}
              </Text>
              <Text as="p" display="block" type="compact" color="secondary">
                {project.summary}
              </Text>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/* Interviews, newest first (the order in about.ts). */}
    <div class="mt-16 animate-reveal reveal-delay-4">
      <Heading level={3} accessibilityLevel={2} className="mb-5">
        {copy.interviewsHeading}
      </Heading>
      <ul class="space-y-4">
        {copy.interviews.map((interview) => (
          <li class="flex flex-col sm:flex-row sm:gap-4">
            <Text type="supporting" hasTabularNumbers className="sm:w-32 sm:shrink-0 sm:pt-1">
              {interview.year}
            </Text>
            <div>
              <Text as="p" display="block" type="compact">
                <Link href={interview.link} color="primary" type="inherit">
                  <span lang={interview.lang}>{interview.name}</span>
                  <Icon icon="externalLink" size="xsm" color="secondary" className="ml-1" />
                </Link>
              </Text>
              <Text as="p" display="block" type="compact" color="secondary">
                {interview.outlet}
              </Text>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/* Certifications. Name and issuer only — no credential numbers. */}
    <div class="mt-16 animate-reveal reveal-delay-5">
      <Heading level={3} accessibilityLevel={2} className="mb-5">
        {copy.certificationsHeading}
      </Heading>
      <ul class="space-y-3">
        {copy.certifications.map((cert) => (
          <li class="flex flex-col sm:flex-row sm:gap-4">
            <Text type="supporting" hasTabularNumbers className="sm:w-32 sm:shrink-0 sm:pt-0.5">
              {cert.year}
            </Text>
            <Text type="compact">
              {cert.name}
              <Text type="inherit" color="secondary">{` · ${cert.issuer}`}</Text>
            </Text>
          </li>
        ))}
      </ul>
    </div>

    {/* The ferret illustration closes the page, below the profile, career, projects, interviews and certifications:
        a sign-off from the site's character rather than a banner. */}
    <div class="mt-16">
      <FerretHero locale={locale} />
    </div>
  </section>
</div>
