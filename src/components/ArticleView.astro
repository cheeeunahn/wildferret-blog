---
import type { LocalizedArticle } from '../content/service'
import AiSummary from './AiSummary'
import { formatInline, parseArticleBody } from '../content/parser'
import { resolveAssetUrl } from '../shared/assetUrl'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'
import { createElement } from 'react'
import { Blockquote } from '@astryxdesign/core/Blockquote'
import { Card } from '@astryxdesign/core/Card'
import { CodeBlock } from '@astryxdesign/core/CodeBlock'
import { Divider } from '@astryxdesign/core/Divider'
import { Heading } from '@astryxdesign/core/Heading'
import { Icon } from '@astryxdesign/core/Icon'
import { Table } from '@astryxdesign/core/Table'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
  article: LocalizedArticle
  /** Body text, already read at build time by the page's getStaticPaths. */
  content: string
}

const { locale, article, content } = Astro.props
const strings = t(locale.lang)
const { summary, blocks } = parseArticleBody(content)

const langLabels: Record<string, string> = {
  bash: 'Terminal',
  json: 'JSON',
  js: 'JavaScript',
  ts: 'TypeScript',
}

// Two spellings of the same stagger: a CSS string for plain elements, a React
// style object for Astryx components.
const delay = (i: number) => `animation-delay: ${i * 0.05}s`
const delayStyle = (i: number) => ({ animationDelay: `${i * 0.05}s` })

// Astryx components here render to static HTML at build time (no client:*), so
// the page stays zero-JS. Anything that needs a click handler to work — the
// CodeBlock copy button, for one — is switched off rather than shipped dead.
// The same goes for CodeBlock's horizontal scroll: statically rendered, its
// scroll area is `overflow: clip`, so a long line would be cut off. Code blocks
// wrap instead (isWrapped). isWrapped also sets `word-break: break-all` on the
// <code>, which splits words mid-letter; the className puts it back to normal,
// leaving Astryx's `overflow-wrap: break-word` to break an overlong token.

// Table cells carry inline markdown (bold, code, links). Astryx's Table takes
// cell renderers rather than children, so the author's own formatInline output
// goes in as HTML here, exactly as set:html does elsewhere in this file. Never
// pass reader-supplied text through this.
const inlineCell = (html: string) =>
  createElement('span', { dangerouslySetInnerHTML: { __html: html } })

type TableBlock = Extract<(typeof blocks)[number], { type: 'table' }>
type Row = Record<string, string>

const tableProps = (block: TableBlock) => ({
  columns: block.header.map((header, c) => ({
    key: `c${c}`,
    header,
    renderCell: (row: Row) => inlineCell(formatInline(row[`c${c}`])),
  })),
  data: block.rows.map((cells): Row => Object.fromEntries(cells.map((cell, c) => [`c${c}`, cell]))),
})
const MAX_CAROUSEL_SLIDES = 6

// The carousel's prev/next controls are <label>s for its radio group, not
// buttons, so they cannot be an Astryx IconButton; this is the same floating
// chip in Astryx tokens. The slide/dot state machine lives in global.css.
const carouselArrowClass =
  'absolute top-1/2 -translate-y-1/2 grid place-items-center size-8 rounded-full border border-ink-100 bg-paper text-ink-600 opacity-85 cursor-pointer transition-[opacity,color] duration-150 hover:opacity-100 hover:text-ink-900'
---

<div class="animate-page-enter">
  {/* Article Header */}
  <header class="max-w-[768px] mx-auto px-6 pt-10 sm:pt-14 pb-8">
    <div class="animate-reveal">
      <div class="mb-5">
        <Text type="supporting">{article.date}</Text>
      </div>

      <Heading level={1} className="mb-3">
        {article.title}
      </Heading>
      <Text as="p" display="block" type="large" color="secondary">
        {article.subtitle}
      </Text>
      {/* AI summary button. client:summarizer (src/directives/summarizer.ts)
            hydrates it only in browsers that have Chrome's Prompt API, so
            everyone else downloads neither the island nor React. */}
      <AiSummary
        client:summarizer
        slug={article.slug}
        title={article.title}
        lang={locale.lang}
        strings={strings.summarizer}
      />
      {article.coverImage && (
        <div class="mt-8">
          <div class="overflow-hidden rounded-2xl border border-ink-100">
            <img
              src={resolveAssetUrl(article.coverImage)}
              alt={article.title}
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
          <Text as="p" display="block" type="supporting" className="mt-3">
            {strings.article.coverImageNote}
          </Text>
        </div>
      )}
    </div>
  </header>

  <div class="max-w-[768px] mx-auto">
    <Divider />
  </div>

  {/* Article Body. Type size, weight and color come from Astryx (Heading,
      Text, Blockquote); the utilities on each block only space it, plus two
      things set once here:
      - Korean wraps on word boundaries, not mid-word (break-keep). It is
        inherited, so code blocks reset it with break-normal: their ASCII
        diagrams rely on literal line breaks.
      - The first block sits flush: the body's own top padding already spaces
        it from the rule above, and an h2's margin on top reads as a hole. */}
  <article
    class="max-w-[768px] mx-auto px-6 pt-9 pb-12 break-keep wrap-break-word [&>:first-child]:mt-0"
    data-article-body
  >
    {summary && (
      <aside data-summary-card class="mb-10 animate-reveal" aria-label={summary.label}>
        <Card variant="muted">
          <Text as="div" display="block" type="label" color="secondary" className="mb-2">
            {summary.label}
          </Text>
          <ul class="list-disc pl-5 space-y-2.5 leading-[1.75] marker:text-ink-300">
            {summary.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ul>
        </Card>
      </aside>
    )}
    {blocks.map((block, i) => {
      if (block.type === 'divider') {
        // An authored `---` is a pause in the writing, not a section rule, so it
        // gets the labelled divider rather than a bare line.
        return <Divider label="· · ·" className="my-10" />
      }

      if (block.type === 'code') {
        return (
          <CodeBlock
            code={block.code}
            language={block.lang || 'plaintext'}
            title={langLabels[block.lang] || block.lang || undefined}
            hasLanguageLabel={false}
            hasCopyButton={false}
            isWrapped
            width="100%"
            className="my-6 break-normal animate-reveal [&_code]:[word-break:normal]!"
            style={delayStyle(i)}
          />
        )
      }

      if (block.type === 'heading' && block.level === 3) {
        return (
          <Heading level={3} className="mt-8 mb-4 animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'heading') {
        return (
          <Heading level={2} className="mt-10 mb-3 animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'quote') {
        return (
          <Blockquote className="my-8 leading-[1.75] animate-reveal" style={delayStyle(i)}>
            <Fragment set:html={formatInline(block.text)} />
          </Blockquote>
        )
      }

      if (block.type === 'list' && !block.ordered) {
        return (
          <ul class="list-disc pl-5 mb-6 space-y-2 leading-[1.75] animate-reveal" style={delay(i)}>
            {block.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ul>
        )
      }

      if (block.type === 'list') {
        return (
          <ol
            class="list-decimal pl-5 mb-6 space-y-2 leading-[1.75] animate-reveal"
            style={delay(i)}
          >
            {block.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ol>
        )
      }

      if (block.type === 'table') {
        const { columns, data } = tableProps(block)
        return (
          <div class="my-6 overflow-x-auto animate-reveal" style={delay(i)}>
            <Table columns={columns} data={data} />
          </div>
        )
      }

      if (block.type === 'carousel') {
        const { slides, caption } = block
        // The slide limit is the CSS's: global.css positions the track for at
        // most this many radio inputs.
        if (slides.length > MAX_CAROUSEL_SLIDES) {
          throw new Error(
            `Carousel in ${article.slug} has ${slides.length} images; only up to ${MAX_CAROUSEL_SLIDES} are supported`,
          )
        }
        const cid = `carousel-${i}`
        return (
          <figure class="carousel group/carousel my-8 animate-reveal" style={delay(i)}>
            {slides.map((_, n) => (
              <input
                type="radio"
                name={cid}
                id={`${cid}-${n}`}
                class="carousel-input sr-only"
                checked={n === 0}
                aria-label={strings.article.carouselSlide(n + 1)}
              />
            ))}
            <div class="overflow-hidden rounded-2xl border border-ink-100 bg-ink-50/40">
              <div class="carousel-track flex">
                {slides.map((slide, n) => (
                  <div class="relative w-full shrink-0">
                    <img
                      src={resolveAssetUrl(slide.src)}
                      alt={slide.alt || article.title}
                      class="h-[240px] sm:h-[320px] w-full object-contain"
                      loading={n === 0 ? 'eager' : 'lazy'}
                    />
                    {n > 0 && (
                      <label
                        for={`${cid}-${n - 1}`}
                        class={`${carouselArrowClass} left-3`}
                        aria-hidden="true"
                      >
                        <Icon icon="chevronLeft" size="sm" />
                      </label>
                    )}
                    {n < slides.length - 1 && (
                      <label
                        for={`${cid}-${n + 1}`}
                        class={`${carouselArrowClass} right-3`}
                        aria-hidden="true"
                      >
                        <Icon icon="chevronRight" size="sm" />
                      </label>
                    )}
                  </div>
                ))}
              </div>
            </div>
            {/* The radios are visually hidden, so their keyboard focus is
                surfaced on the dots row — the arrow keys move through the
                group from there. */}
            <div class="mt-3 flex items-center justify-center gap-2 rounded-full group-has-[.carousel-input:focus-visible]/carousel:outline-2 group-has-[.carousel-input:focus-visible]/carousel:outline-ink-300 group-has-[.carousel-input:focus-visible]/carousel:outline-offset-6">
              {slides.map((_, n) => (
                <label
                  for={`${cid}-${n}`}
                  class="carousel-dot block size-1.5 rounded-full cursor-pointer transition-colors duration-150"
                  aria-hidden="true"
                />
              ))}
            </div>
            {caption && (
              <figcaption
                class="mt-2 text-center text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(caption)}
              />
            )}
          </figure>
        )
      }

      if (block.type === 'image') {
        const { image } = block
        return (
          <figure class="my-8 animate-reveal" style={delay(i)}>
            <div class="overflow-hidden rounded-2xl border border-ink-100">
              <img
                src={resolveAssetUrl(image.src)}
                alt={image.alt || article.title}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            {image.caption && (
              <figcaption
                class="mt-3 text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(image.caption)}
              />
            )}
          </figure>
        )
      }

      return (
        <Text
          as="p"
          display="block"
          className="mb-6 leading-[1.75] animate-reveal"
          style={delayStyle(i)}
        >
          <Fragment set:html={formatInline(block.text)} />
        </Text>
      )
    })}
  </article>

  {/* Back link */}
  <div class="max-w-[768px] mx-auto px-6 pb-20">
    <Divider className="mb-10" />
    <a
      href={localeHref(locale, '/')}
      class="inline-flex items-center gap-2 text-sm text-ink-600 no-underline hover:text-ink-700 transition-colors"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {strings.article.back}
    </a>
  </div>
</div>
