---
import type { LocalizedArticle } from '../content/service'
import AiSummary from './AiSummary'
import Comments from './Comments'
import PageContainer from './PageContainer.astro'
import { formatInline, parseArticleBody } from '../content/parser'
import { resolveAssetUrl } from '../shared/assetUrl'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'
import { createElement } from 'react'
import { Blockquote } from '@astryxdesign/core/Blockquote'
import { Card } from '@astryxdesign/core/Card'
import { CodeBlock } from '@astryxdesign/core/CodeBlock'
import { Divider } from '@astryxdesign/core/Divider'
import { Heading } from '@astryxdesign/core/Heading'
import { Table } from '@astryxdesign/core/Table'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
  article: LocalizedArticle
  /** Body text, already read at build time by the page's getStaticPaths. */
  content: string
}

const { locale, article, content } = Astro.props
const strings = t(locale.lang)
const { summary, blocks } = parseArticleBody(content)

const langLabels: Record<string, string> = {
  bash: 'Terminal',
  json: 'JSON',
  js: 'JavaScript',
  ts: 'TypeScript',
}

// Two spellings of the same stagger: a CSS string for plain elements, a React
// style object for Astryx components.
const delay = (i: number) => `animation-delay: ${i * 0.05}s`
const delayStyle = (i: number) => ({ animationDelay: `${i * 0.05}s` })

// Astryx components here render to static HTML at build time (no client:*), so
// the page stays zero-JS. Anything that needs a click handler to work — the
// CodeBlock copy button, for one — is switched off rather than shipped dead.

// Table cells carry inline markdown (bold, code, links). Astryx's Table takes
// cell renderers rather than children, so the author's own formatInline output
// goes in as HTML here, exactly as set:html does elsewhere in this file. Never
// pass reader-supplied text through this.
const inlineCell = (html: string) =>
  createElement('span', { dangerouslySetInnerHTML: { __html: html } })

type TableBlock = Extract<(typeof blocks)[number], { type: 'table' }>
type Row = Record<string, string>

const tableProps = (block: TableBlock) => ({
  columns: block.header.map((header, c) => ({
    key: `c${c}`,
    header,
    renderCell: (row: Row) => inlineCell(formatInline(row[`c${c}`])),
  })),
  data: block.rows.map((cells): Row => Object.fromEntries(cells.map((cell, c) => [`c${c}`, cell]))),
})
const MAX_CAROUSEL_SLIDES = 6
---

<div class="page-enter">
  {/* Article header, after the Astryx "Documentation Technical" example: a
      large title, one muted meta line, the subtitle, then the AI card. There
      is deliberately no cover image here; cards still use cardImage. */}
  <PageContainer as="header" class="pt-8 sm:pt-14 pb-6 sm:pb-8">
    <div class="animate-reveal">
      <Heading level={1} type="display-3" className="page-title mb-3">
        {article.title}
      </Heading>
      <div class="page-meta mb-5">
        <Text type="supporting">{article.date}</Text>
        <span class="text-ink-300" aria-hidden="true">
          ·
        </span>
        <Text type="supporting">{strings.article.readTime(article.readMinutes)}</Text>
      </div>
      <Text as="p" display="block" type="large" color="secondary" className="page-subtitle">
        {article.subtitle}
      </Text>
      {/* AI summary card. client:summarizer (src/directives/summarizer.ts)
            hydrates it only in browsers that have Chrome's Prompt API, so
            everyone else downloads neither the island nor React — and sees
            nothing here, rather than a card that cannot work. */}
      <AiSummary
        client:summarizer
        slug={article.slug}
        title={article.title}
        lang={locale.lang}
        strings={strings.summarizer}
      />
    </div>
  </PageContainer>

  {/* Article Body */}
  <PageContainer as="article" class="pt-4 sm:pt-6 pb-12 prose-blog" data-article-body>
    {summary && (
      <aside data-summary-card class="mb-10 animate-reveal" aria-label={summary.label}>
        <Card variant="muted">
          <Text as="div" display="block" type="label" color="secondary" className="mb-2">
            {summary.label}
          </Text>
          <ul class="list-disc pl-5 space-y-2.5 marker:text-ink-300">
            {summary.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ul>
        </Card>
      </aside>
    )}
    {blocks.map((block, i) => {
      if (block.type === 'divider') {
        // An authored `---` is a pause in the writing, not a section rule, so it
        // gets the labelled divider rather than a bare line.
        return <Divider label="· · ·" className="my-10" />
      }

      if (block.type === 'code') {
        return (
          <CodeBlock
            code={block.code}
            language={block.lang || 'plaintext'}
            title={langLabels[block.lang] || block.lang || undefined}
            hasLanguageLabel={false}
            hasCopyButton={false}
            width="100%"
            className="my-6 animate-reveal"
            style={delayStyle(i)}
          />
        )
      }

      if (block.type === 'heading' && block.level === 3) {
        return (
          <Heading level={3} className="mt-8 mb-4 animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'heading') {
        return (
          <Heading level={2} className="animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'quote') {
        return (
          <Blockquote className="animate-reveal" style={delayStyle(i)}>
            <Fragment set:html={formatInline(block.text)} />
          </Blockquote>
        )
      }

      if (block.type === 'list' && !block.ordered) {
        return (
          <ul class="list-disc pl-5 mb-6 space-y-2 animate-reveal" style={delay(i)}>
            {block.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ul>
        )
      }

      if (block.type === 'list') {
        return (
          <ol class="list-decimal pl-5 mb-6 space-y-2 animate-reveal" style={delay(i)}>
            {block.items.map((item) => (
              <li>
                <Text>
                  <Fragment set:html={formatInline(item)} />
                </Text>
              </li>
            ))}
          </ol>
        )
      }

      if (block.type === 'table') {
        const { columns, data } = tableProps(block)
        return (
          <div class="my-6 overflow-x-auto animate-reveal" style={delay(i)}>
            <Table columns={columns} data={data} />
          </div>
        )
      }

      if (block.type === 'carousel') {
        const { slides, caption } = block
        // The slide limit is the CSS's: global.css positions the track for at
        // most this many radio inputs.
        if (slides.length > MAX_CAROUSEL_SLIDES) {
          throw new Error(
            `Carousel in ${article.slug} has ${slides.length} images; only up to ${MAX_CAROUSEL_SLIDES} are supported`,
          )
        }
        const cid = `carousel-${i}`
        return (
          <figure class="carousel my-8 animate-reveal" style={delay(i)}>
            {slides.map((_, n) => (
              <input
                type="radio"
                name={cid}
                id={`${cid}-${n}`}
                class="carousel-input sr-only"
                checked={n === 0}
                aria-label={strings.article.carouselSlide(n + 1)}
              />
            ))}
            <div class="overflow-hidden rounded-2xl border border-ink-100 bg-ink-50/40">
              <div class="carousel-track flex">
                {slides.map((slide, n) => (
                  <div class="relative w-full shrink-0">
                    <img
                      src={resolveAssetUrl(slide.src)}
                      alt={slide.alt || article.title}
                      class="h-[240px] sm:h-[320px] w-full object-contain"
                      loading={n === 0 ? 'eager' : 'lazy'}
                    />
                    {n > 0 && (
                      <label
                        for={`${cid}-${n - 1}`}
                        class="carousel-arrow carousel-arrow-prev"
                        aria-hidden="true"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="15 18 9 12 15 6" />
                        </svg>
                      </label>
                    )}
                    {n < slides.length - 1 && (
                      <label
                        for={`${cid}-${n + 1}`}
                        class="carousel-arrow carousel-arrow-next"
                        aria-hidden="true"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="9 6 15 12 9 18" />
                        </svg>
                      </label>
                    )}
                  </div>
                ))}
              </div>
            </div>
            <div class="carousel-dots mt-3 flex items-center justify-center gap-2">
              {slides.map((_, n) => (
                <label for={`${cid}-${n}`} class="carousel-dot" aria-hidden="true" />
              ))}
            </div>
            {caption && (
              <figcaption
                class="mt-2 text-center text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(caption)}
              />
            )}
          </figure>
        )
      }

      if (block.type === 'image') {
        const { image } = block
        return (
          <figure class="my-8 animate-reveal" style={delay(i)}>
            <div class="overflow-hidden rounded-2xl border border-ink-100">
              <img
                src={resolveAssetUrl(image.src)}
                alt={image.alt || article.title}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            {image.caption && (
              <figcaption
                class="mt-3 text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(image.caption)}
              />
            )}
          </figure>
        )
      }

      return (
        <Text as="p" display="block" className="animate-reveal" style={delayStyle(i)}>
          <Fragment set:html={formatInline(block.text)} />
        </Text>
      )
    })}
  </PageContainer>

  {/* Comments. client:visible, not client:only — the island has no
        server-hostile code, so the shell prerenders and the React runtime only
        downloads once a reader actually scrolls this far.
        Keyed by slug alone, so a post's thread is shared across all three
        language trees rather than split per language. */}
  <PageContainer class="pb-4">
    <Divider className="mb-10" />
    <Comments
      client:visible
      articleSlug={article.slug}
      strings={strings.comments}
      lang={locale.lang}
    />
  </PageContainer>

  {/* Back link */}
  <PageContainer class="pb-16 sm:pb-20">
    <Divider className="mb-10" />
    <a
      href={localeHref(locale, '/')}
      class="inline-flex items-center gap-2 min-h-11 text-sm text-ink-600 no-underline hover:text-ink-700 transition-colors"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {strings.article.back}
    </a>
  </PageContainer>
</div>
