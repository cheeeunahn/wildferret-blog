---
import type { LocalizedArticle } from '../content/service'
import AiSummary from './AiSummary'
import ArticleMarkdown from './ArticleMarkdown'
import { formatInline, parseArticleBody } from '../content/parser'
import { resolveAssetUrl } from '../shared/assetUrl'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'
import { createElement } from 'react'
import { Blockquote } from '@astryxdesign/core/Blockquote'
import { Card } from '@astryxdesign/core/Card'
import { CodeBlock } from '@astryxdesign/core/CodeBlock'
import { Divider } from '@astryxdesign/core/Divider'
import { Heading } from '@astryxdesign/core/Heading'
import { Icon } from '@astryxdesign/core/Icon'
import { Link } from '@astryxdesign/core/Link'
import { Table } from '@astryxdesign/core/Table'
import { Text } from '@astryxdesign/core/Text'

interface Props {
  locale: Locale
  article: LocalizedArticle
  /** Body text, already read at build time by the page's getStaticPaths. */
  content: string
}

const { locale, article, content } = Astro.props
const strings = t(locale.lang)
const { summary, blocks } = parseArticleBody(content)

const langLabels: Record<string, string> = {
  bash: 'Terminal',
  json: 'JSON',
  js: 'JavaScript',
  ts: 'TypeScript',
}

// Two spellings of the same stagger: a CSS string for plain elements, a React
// style object for Astryx components.
const delay = (i: number) => `animation-delay: ${i * 0.05}s`
const delayStyle = (i: number) => ({ animationDelay: `${i * 0.05}s` })

// Astryx components here render to static HTML at build time (no client:*), so
// they ship no JavaScript. Anything that needs a click handler to work — the
// CodeBlock copy button, for one — is switched off rather than shipped dead.
// The same goes for CodeBlock's horizontal scroll: statically rendered, its
// scroll area is `overflow: clip`, so a long line would be cut off. Code blocks
// wrap instead (isWrapped). isWrapped also sets `word-break: break-all` on the
// <code>, which splits words mid-letter; the className puts it back to normal,
// leaving Astryx's `overflow-wrap: break-word` to break an overlong token.

// Table cells carry inline markdown (bold, code, links). Astryx's Table takes
// cell renderers rather than children, so the author's own formatInline output
// goes in as HTML here, exactly as set:html does elsewhere in this file. Never
// pass reader-supplied text through this.
const inlineCell = (html: string) =>
  createElement('span', { dangerouslySetInnerHTML: { __html: html } })

type TableBlock = Extract<(typeof blocks)[number], { type: 'table' }>
type Row = Record<string, string>

const tableProps = (block: TableBlock) => ({
  columns: block.header.map((header, c) => ({
    key: `c${c}`,
    header,
    renderCell: (row: Row) => inlineCell(formatInline(row[`c${c}`])),
  })),
  data: block.rows.map((cells): Row => Object.fromEntries(cells.map((cell, c) => [`c${c}`, cell]))),
})

// Article lists go through Astryx's Markdown (ArticleMarkdown.tsx), which takes
// Markdown source: turn the parsed items back into a list. Link targets are
// resolved first, as formatInline does for prose, so a site-relative link keeps
// working under a BASE_PATH deploy.
const toMarkdownList = (items: string[], ordered = false) =>
  items
    .map((item) => item.replace(/\]\(([^)\s]+)\)/g, (_, url) => `](${resolveAssetUrl(url)})`))
    .map((item, n) => `${ordered ? `${n + 1}.` : '-'} ${item}`)
    .join('\n')
---

<div class="animate-page-enter">
  {/* Article Header */}
  <header class="max-w-[768px] mx-auto px-6 pt-10 sm:pt-14 pb-8">
    <div class="animate-reveal">
      <div class="mb-5">
        <Text type="supporting">{article.date}</Text>
      </div>

      {/* break-keep: Korean wraps between words, not inside one. text-pretty
          keeps a single word from being stranded on the last line. */}
      <Heading level={1} className="mb-3 break-keep text-pretty">
        {article.title}
      </Heading>
      <Text
        as="p"
        display="block"
        type="large"
        color="secondary"
        className="break-keep text-pretty"
      >
        {article.subtitle}
      </Text>
      {/* AI summary button. client:summarizer (src/directives/summarizer.ts)
            hydrates it only in browsers that have Chrome's Prompt API, so
            everyone else downloads neither the island nor React. */}
      <AiSummary
        client:summarizer
        slug={article.slug}
        title={article.title}
        lang={locale.lang}
        strings={strings.summarizer}
      />
    </div>
  </header>

  <div class="max-w-[768px] mx-auto">
    <Divider />
  </div>

  {/* Article Body. Type size, weight and color come from Astryx (Heading,
      Text, Blockquote); the utilities on each block only space it, plus two
      things set once here:
      - Korean wraps on word boundaries, not mid-word (break-keep). It is
        inherited, so code blocks reset it with break-normal: a long line of
        code wraps where it has to, not only between words.
      - The first block sits flush: the body's own top padding already spaces
        it from the rule above, and an h2's margin on top reads as a hole. */}
  <article
    class="max-w-[768px] mx-auto px-6 pt-9 pb-12 break-keep wrap-break-word [&>:first-child]:mt-0"
    data-article-body
  >
    {summary && (
      <aside data-summary-card class="mb-10 animate-reveal" aria-label={summary.label}>
        <Card variant="muted">
          <Text as="div" display="block" type="label" color="secondary" className="mb-2">
            {summary.label}
          </Text>
          <ArticleMarkdown source={toMarkdownList(summary.items)} />
        </Card>
      </aside>
    )}
    {blocks.map((block, i) => {
      if (block.type === 'divider') {
        // An authored `---` is a pause in the writing, not a section rule, so it
        // gets the labelled divider rather than a bare line.
        return <Divider label="· · ·" className="my-10" />
      }

      if (block.type === 'code') {
        return (
          <CodeBlock
            code={block.code}
            language={block.lang || 'plaintext'}
            title={langLabels[block.lang] || block.lang || undefined}
            hasLanguageLabel={false}
            hasCopyButton={false}
            isWrapped
            width="100%"
            className="my-6 break-normal animate-reveal [&_code]:[word-break:normal]!"
            style={delayStyle(i)}
          />
        )
      }

      if (block.type === 'heading' && block.level === 3) {
        return (
          <Heading level={3} className="mt-8 mb-4 animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'heading') {
        return (
          <Heading level={2} className="mt-10 mb-3 animate-reveal" style={delayStyle(i)}>
            {block.text}
          </Heading>
        )
      }

      if (block.type === 'quote') {
        return (
          <Blockquote className="my-8 animate-reveal" style={delayStyle(i)}>
            <Text type="prose" color="inherit">
              <Fragment set:html={formatInline(block.text)} />
            </Text>
          </Blockquote>
        )
      }

      if (block.type === 'list' && !block.ordered) {
        return (
          <div class="mb-6 animate-reveal" style={delay(i)}>
            <ArticleMarkdown source={toMarkdownList(block.items)} />
          </div>
        )
      }

      if (block.type === 'list') {
        return (
          <div class="mb-6 animate-reveal" style={delay(i)}>
            <ArticleMarkdown source={toMarkdownList(block.items, true)} />
          </div>
        )
      }

      if (block.type === 'table') {
        const { columns, data } = tableProps(block)
        return (
          <div class="my-6 overflow-x-auto animate-reveal" style={delay(i)}>
            <Table columns={columns} data={data} />
          </div>
        )
      }

      if (block.type === 'image') {
        const { image } = block
        return (
          <figure class="my-8 animate-reveal" style={delay(i)}>
            <div class="overflow-hidden rounded-(--radius-container) border border-ink-100">
              <img
                src={resolveAssetUrl(image.src)}
                alt={image.alt || article.title}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            {image.caption && (
              <figcaption class="mt-3">
                <Text type="supporting" display="block">
                  <Fragment set:html={formatInline(image.caption)} />
                </Text>
              </figcaption>
            )}
          </figure>
        )
      }

      return (
        <Text
          as="p"
          display="block"
          type="prose"
          className="mb-6 animate-reveal"
          style={delayStyle(i)}
        >
          <Fragment set:html={formatInline(block.text)} />
        </Text>
      )
    })}
  </article>

  {/* Back link */}
  <div class="max-w-[768px] mx-auto px-6 pb-20">
    <Divider className="mb-10" />
    <Link
      href={localeHref(locale, '/')}
      color="secondary"
      className="inline-flex items-center gap-1"
    >
      <Icon icon="chevronLeft" size="sm" />
      {strings.article.back}
    </Link>
  </div>
</div>
