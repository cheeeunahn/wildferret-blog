---
import type { LocalizedArticle } from '../content/service'
import AiSummary from './AiSummary'
import Comments from './Comments'
import { formatInline, parseArticleBody } from '../content/parser'
import { resolveAssetUrl } from '../shared/assetUrl'
import { localeHref, type Locale } from '../shared/i18n'
import { t } from '../copy/strings'

interface Props {
  locale: Locale
  article: LocalizedArticle
  /** Body text, already read at build time by the page's getStaticPaths. */
  content: string
}

const { locale, article, content } = Astro.props
const strings = t(locale.lang)
const { summary, blocks } = parseArticleBody(content)

const langLabels: Record<string, string> = {
  bash: 'Terminal',
  json: 'JSON',
  js: 'JavaScript',
  ts: 'TypeScript',
}

const delay = (i: number) => `animation-delay: ${i * 0.05}s`
const MAX_CAROUSEL_SLIDES = 6
---

<div class="page-enter">
  {/* Article Header */}
  <header class="max-w-[720px] mx-auto px-6 pt-10 sm:pt-14 pb-8">
    <div class="animate-reveal">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-5">
        <span class="text-xs text-ink-500">{article.date}</span>
        <span class="w-px h-3 bg-ink-200"></span>
        <span class="text-xs text-ink-500">{strings.article.readTime(article.readMinutes)}</span>
      </div>

      <h1 class="text-[28px] sm:text-[36px] font-bold text-ink-950 leading-tight tracking-tight mb-3">
        {article.title}
      </h1>
      <p class="text-ink-600 text-base leading-relaxed">{article.subtitle}</p>
      {/* AI summary button. client:summarizer (src/directives/summarizer.ts)
            hydrates it only in browsers that have Chrome's Prompt API, so
            everyone else downloads neither the island nor React. */}
      <AiSummary
        client:summarizer
        slug={article.slug}
        title={article.title}
        lang={locale.lang}
        strings={strings.summarizer}
      />
      {article.coverImage && (
        <div class="mt-8">
          <div class="overflow-hidden rounded-2xl border border-ink-100">
            <img
              src={resolveAssetUrl(article.coverImage)}
              alt={article.title}
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
          <p class="mt-3 text-sm text-ink-600 leading-relaxed">{strings.article.coverImageNote}</p>
        </div>
      )}
    </div>
  </header>

  <hr class="ink-divider max-w-[720px] mx-auto" />

  {/* Article Body */}
  <article class="max-w-[720px] mx-auto px-6 pt-9 pb-12 prose-blog" data-article-body>
    {summary && (
      <aside
        data-summary-card
        class="mb-10 rounded-xl border border-ink-100 overflow-hidden animate-reveal"
        aria-label={summary.label}
      >
        <div class="px-4 py-2 border-b border-ink-100 bg-ink-50/60 text-[13px] text-ink-600">
          {summary.label}
        </div>
        <div class="px-5 py-4">
          <ul class="list-disc pl-5 space-y-2.5 marker:text-ink-300 text-ink-700 text-[15px] leading-relaxed">
            {summary.items.map((item) => (
              <li set:html={formatInline(item)} />
            ))}
          </ul>
        </div>
      </aside>
    )}
    {blocks.map((block, i) => {
      if (block.type === 'divider') {
        return <hr class="ink-divider my-10" />
      }

      if (block.type === 'code') {
        const label = langLabels[block.lang] || block.lang
        return (
          <div
            class="my-6 rounded-xl border border-ink-100 overflow-hidden animate-reveal"
            style={delay(i)}
          >
            <div class="flex items-center gap-1.5 px-4 py-2 border-b border-ink-100 bg-ink-50/60">
              <div class="w-[7px] h-[7px] rounded-full border border-ink-300/70" />
              <div class="w-[7px] h-[7px] rounded-full border border-ink-300/70" />
              <div class="w-[7px] h-[7px] rounded-full border border-ink-300/70" />
              {label && <span class="ml-2 text-[11px] text-ink-600">{label}</span>}
            </div>
            <pre class="px-4 py-3 bg-paper-warm/40 overflow-x-auto"><code class="text-[13px] text-ink-600 leading-relaxed whitespace-pre block font-mono">{block.code}</code></pre>
          </div>
        )
      }

      if (block.type === 'heading' && block.level === 3) {
        return (
          <h3 class="text-lg font-semibold text-ink-900 mt-8 mb-4 animate-reveal" style={delay(i)}>
            {block.text}
          </h3>
        )
      }

      if (block.type === 'heading') {
        return (
          <h2 class="animate-reveal" style={delay(i)}>
            {block.text}
          </h2>
        )
      }

      if (block.type === 'quote') {
        return (
          <blockquote class="animate-reveal" style={delay(i)} set:html={formatInline(block.text)} />
        )
      }

      if (block.type === 'list' && !block.ordered) {
        return (
          <ul
            class="list-disc pl-5 mb-6 space-y-2 text-ink-700 text-[17px] leading-relaxed animate-reveal"
            style={delay(i)}
          >
            {block.items.map((item) => (
              <li set:html={formatInline(item)} />
            ))}
          </ul>
        )
      }

      if (block.type === 'list') {
        return (
          <ol
            class="list-decimal pl-5 mb-6 space-y-2 text-ink-700 text-[17px] leading-relaxed animate-reveal"
            style={delay(i)}
          >
            {block.items.map((item) => (
              <li set:html={formatInline(item)} />
            ))}
          </ol>
        )
      }

      if (block.type === 'table') {
        return (
          <div
            class="my-6 overflow-x-auto rounded-xl border border-ink-100 animate-reveal"
            style={delay(i)}
          >
            <table class="w-full min-w-[560px] text-[15px]">
              <thead>
                <tr class="border-b border-ink-100 bg-ink-50/60">
                  {block.header.map((cell) => (
                    <th class="px-4 py-2.5 text-left text-xs font-semibold text-ink-500 uppercase tracking-wide">
                      {cell}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {block.rows.map((cells, j) => (
                  <tr class={j < block.rows.length - 1 ? 'border-b border-ink-50' : ''}>
                    {cells.map((cell) => (
                      <td
                        class="px-4 py-2.5 text-ink-700 leading-relaxed"
                        set:html={formatInline(cell)}
                      />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      if (block.type === 'carousel') {
        const { slides, caption } = block
        // The slide limit is the CSS's: global.css positions the track for at
        // most this many radio inputs.
        if (slides.length > MAX_CAROUSEL_SLIDES) {
          throw new Error(
            `Carousel in ${article.slug} has ${slides.length} images; only up to ${MAX_CAROUSEL_SLIDES} are supported`,
          )
        }
        const cid = `carousel-${i}`
        return (
          <figure class="carousel my-8 animate-reveal" style={delay(i)}>
            {slides.map((_, n) => (
              <input
                type="radio"
                name={cid}
                id={`${cid}-${n}`}
                class="carousel-input sr-only"
                checked={n === 0}
                aria-label={strings.article.carouselSlide(n + 1)}
              />
            ))}
            <div class="overflow-hidden rounded-2xl border border-ink-100 bg-ink-50/40">
              <div class="carousel-track flex">
                {slides.map((slide, n) => (
                  <div class="relative w-full shrink-0">
                    <img
                      src={resolveAssetUrl(slide.src)}
                      alt={slide.alt || article.title}
                      class="h-[240px] sm:h-[320px] w-full object-contain"
                      loading={n === 0 ? 'eager' : 'lazy'}
                    />
                    {n > 0 && (
                      <label
                        for={`${cid}-${n - 1}`}
                        class="carousel-arrow carousel-arrow-prev"
                        aria-hidden="true"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="15 18 9 12 15 6" />
                        </svg>
                      </label>
                    )}
                    {n < slides.length - 1 && (
                      <label
                        for={`${cid}-${n + 1}`}
                        class="carousel-arrow carousel-arrow-next"
                        aria-hidden="true"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="9 6 15 12 9 18" />
                        </svg>
                      </label>
                    )}
                  </div>
                ))}
              </div>
            </div>
            <div class="carousel-dots mt-3 flex items-center justify-center gap-2">
              {slides.map((_, n) => (
                <label for={`${cid}-${n}`} class="carousel-dot" aria-hidden="true" />
              ))}
            </div>
            {caption && (
              <figcaption
                class="mt-2 text-center text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(caption)}
              />
            )}
          </figure>
        )
      }

      if (block.type === 'image') {
        const { image } = block
        return (
          <figure class="my-8 animate-reveal" style={delay(i)}>
            <div class="overflow-hidden rounded-2xl border border-ink-100">
              <img
                src={resolveAssetUrl(image.src)}
                alt={image.alt || article.title}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            {image.caption && (
              <figcaption
                class="mt-3 text-sm text-ink-600 leading-relaxed"
                set:html={formatInline(image.caption)}
              />
            )}
          </figure>
        )
      }

      return <p class="animate-reveal" style={delay(i)} set:html={formatInline(block.text)} />
    })}
  </article>

  {/* Comments. client:visible, not client:only — the island has no
        server-hostile code, so the shell prerenders and the React runtime only
        downloads once a reader actually scrolls this far.
        Keyed by slug alone, so a post's thread is shared across all three
        language trees rather than split per language. */}
  <div class="max-w-[720px] mx-auto px-6 pb-4">
    <hr class="ink-divider mb-10" />
    <Comments
      client:visible
      articleSlug={article.slug}
      strings={strings.comments}
      lang={locale.lang}
    />
  </div>

  {/* Back link */}
  <div class="max-w-[720px] mx-auto px-6 pb-20">
    <hr class="ink-divider mb-10" />
    <a
      href={localeHref(locale, '/')}
      class="inline-flex items-center gap-2 text-sm text-ink-600 no-underline hover:text-ink-700 transition-colors"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {strings.article.back}
    </a>
  </div>
</div>
