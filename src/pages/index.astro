---
// The Korean index at the site root. /kr/ renders the same view under an
// explicit prefix — see src/pages/[lang]/index.astro.
import Base from '../layouts/Base.astro'
import HomeView from '../components/HomeView.astro'
import { ROOT_LOCALE } from '../shared/i18n'
import { t } from '../copy/strings'
---

<Base locale={ROOT_LOCALE} description={t(ROOT_LOCALE.lang).siteDescription}>
  <HomeView locale={ROOT_LOCALE} />
</Base>
