---
import Base from '../layouts/Base.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { articles } from '../data/articles'
import { CATEGORIES } from '../data/articleTypes'
import { resolveAssetUrl } from '../lib/assetUrl'

// Only offer a pill for a category that actually has articles, in the fixed
// CATEGORIES order rather than in publication order.
const usedCategories = CATEGORIES.filter((c) =>
  articles.some((a) => a.category === c),
)

// The filter is CSS-only (radio + :has(), like the carousel), so the rule that
// hides non-matching cards has to exist per category. Generated from the data
// here so adding a category to articleTypes.ts is the only edit needed.
// The hero's later frames: same ferret, turned to face the reader, then
// greeting them properly. Stepped through by the radio group below.
const GREET_FRAMES = [
  {
    src: '/assets/images/wildferret-hero-greeting.webp',
    alt: '페럿이 고개를 들어 정면을 바라보며 손을 흔들어 인사하는 일러스트',
  },
  {
    src: '/assets/images/wildferret-hero-greeting-2.webp',
    alt: '페럿이 활짝 웃으며 반갑게 인사하는 일러스트',
  },
]

const filterCss = usedCategories
  .map(
    (c, i) =>
      `.cat-scope:has(#cat-${i + 1}:checked) [data-cat]:not([data-cat="${c}"]){display:none}`,
  )
  .join('\n')
---

<Base>
  <div class="page-enter">
    {/* Hero, on a full-bleed tonal band. This is what separates the hero from
        the article list — a change of ground rather than a rule across it. A
        hairline says "here is a boundary" and nothing more; a band says the two
        regions are different kinds of thing, which is the actual relationship.
        It also means the separation survives at any width without a 720px line
        floating in the middle of a wide screen. */}
    <div class="bg-paper-warm">
    <section class="max-w-[720px] mx-auto px-6 pt-10 sm:pt-14 pb-12">
        {/* The box is taller than the source's 16:9, so object-cover crops the
            sides and the ferret renders larger. Its focal point is right of
            centre and high, hence object-[62%_38%] rather than the default.
            The <label> makes the whole illustration the click target for the
            greeting; the checkbox inside it is the state. */}
        <figure class="m-0 animate-reveal-media delay-1">
        <div
          class="hero-greet relative block overflow-hidden rounded-2xl bg-paper-warm/30"
        >
          <input
            type="radio"
            name="hero-state"
            id="hero-s0"
            class="hero-state sr-only"
            checked
            aria-label="작업 중인 페럿"
          />
          <input
            type="radio"
            name="hero-state"
            id="hero-s1"
            class="hero-state sr-only"
            aria-label="인사하는 페럿"
          />
          <input
            type="radio"
            name="hero-state"
            id="hero-s2"
            class="hero-state sr-only"
            aria-label="활짝 웃으며 인사하는 페럿"
          />

          <img
            src={resolveAssetUrl('/assets/images/wildferret-hero-coding.webp')}
            alt="안경을 쓴 페럿이 책상에서 노트북으로 코드를 작성하는 일러스트"
            class="w-full h-[260px] sm:h-[440px] object-cover object-[62%_38%]"
            loading="eager"
          />
          {
            GREET_FRAMES.map((frame, i) => (
              <img
                src={resolveAssetUrl(frame.src)}
                alt={frame.alt}
                class={`hero-frame hero-frame-${i + 1} absolute inset-0 w-full h-full object-cover object-[62%_38%]`}
                loading="eager"
              />
            ))
          }

          {/* Fireflies. Decorative and click-through (pointer-events: none in
              global.css), so they sit above the frames but below the labels
              and never block the greeting. Each one carries its own drift and
              pulse timing — see .hero-firefly-N. */}
          <div class="hero-fireflies" aria-hidden="true">
            {
              Array.from({ length: 7 }, (_, i) => (
                <span class={`hero-firefly hero-firefly-${i + 1}`} />
              ))
            }
          </div>

          {/* Only the label for the next state is displayed (see global.css),
              so clicking the same spot again advances the cycle. */}
          <label for="hero-s1" class="hero-step hero-step-1">
            <span class="sr-only">페럿에게 인사 건네기</span>
          </label>
          <label for="hero-s2" class="hero-step hero-step-2">
            <span class="sr-only">페럿의 인사 더 보기</span>
          </label>
          <label for="hero-s0" class="hero-step hero-step-0">
            <span class="sr-only">처음 모습으로 돌아가기</span>
          </label>

          {/* Room tone for the desk scene: office ambience with the ferret's
              own typing layered over it, started and stopped together. The two
              loops are different lengths (56s and 8s), so they drift against
              each other instead of repeating as one fixed bar.
              Off by default and preload="none", so nothing is fetched until a
              reader asks for it — and browsers block autoplay without a
              gesture anyway. The button sits above the step labels so it does
              not advance the greeting. */}
          <audio
            class="hero-audio"
            src={resolveAssetUrl('/assets/audio/office-ambience.mp3')}
            data-volume="0.35"
            loop
            preload="none"></audio>
          <audio
            class="hero-audio"
            src={resolveAssetUrl('/assets/audio/keyboard-typing.mp3')}
            data-volume="0.22"
            loop
            preload="none"></audio>
          <button type="button" class="hero-sound" aria-pressed="false" aria-label="주변 소리 켜기">
            <svg class="hero-sound-icon hero-sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H3v6h3l5 4z" />
              <path d="m16 9 5 6" />
              <path d="m21 9-5 6" />
            </svg>
            <svg class="hero-sound-icon hero-sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H3v6h3l5 4z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7" />
              <path d="M18.5 5.5a9 9 0 0 1 0 13" />
            </svg>
          </button>
        </div>

        {/* Sits outside the frame rather than over the art: the illustration is
            busy at the bottom edge and an overlay would need a scrim to stay
            legible, which reads as a header band on a photo. Small and quiet —
            this labels the picture, it is not the page's headline. */}
        <figcaption class="mt-3 text-sm text-ink-500">
          소리 키고 클릭하면 좋은 일이 있을 수도? 위 이미지를 눌러보세요 🍀
        </figcaption>
        </figure>

        {/* The one bit the CSS state machine cannot do: drop back to the idle
            frame when the reader stops clicking. Inline and dependency-free on
            purpose — see the islands policy in CLAUDE.md; this is not a
            hydrated component. */}
        <script is:inline>
          ;(() => {
            const idle = document.getElementById('hero-s0')
            if (idle) {
              const states = document.querySelectorAll('.hero-state')
              let timer
              states.forEach((input) => {
                input.addEventListener('change', () => {
                  clearTimeout(timer)
                  if (input === idle) return
                  timer = setTimeout(() => {
                    idle.checked = true
                  }, 6000)
                })
              })
            }

            // Sound toggle. aria-pressed is the single source of truth: the
            // CSS swaps the icon off it, so nothing can drift out of sync.
            const button = document.querySelector('.hero-sound')
            const tracks = [...document.querySelectorAll('.hero-audio')]
            if (!button || !tracks.length) return
            // Mixed here rather than in the files: typing sits under the room
            // tone, and both sit well under the page.
            tracks.forEach((track) => {
              track.volume = Number(track.dataset.volume || 0.3)
            })
            const setState = (on) => {
              button.setAttribute('aria-pressed', String(on))
              button.setAttribute('aria-label', on ? '주변 소리 끄기' : '주변 소리 켜기')
            }
            button.addEventListener('click', () => {
              if (button.getAttribute('aria-pressed') === 'true') {
                tracks.forEach((track) => track.pause())
                setState(false)
                return
              }
              setState(true)
              // play() rejects if the browser refuses the gesture; if any
              // layer is blocked, stop them all rather than showing sound
              // that is only half playing.
              Promise.all(tracks.map((track) => track.play())).catch(() => {
                tracks.forEach((track) => track.pause())
                setState(false)
              })
            })
          })()
        </script>
    </section>
    </div>

    {/* Category filter + article list. The :has() rules read from .cat-scope,
        so the radios and the cards must stay inside this one element. */}
    <div class="cat-scope pt-12 sm:pt-14">
      <style is:inline set:html={filterCss}></style>

      {/* The filter sticks below the header so it stays reachable while you
          scroll the list — top-16 is the header's own h-16, and z-40 keeps it
          under the header rather than sliding over it. The band is a full-bleed
          div and only the inner section is width-capped, so the cards pass
          behind an opaque strip instead of showing through beside a 720px box.
          The region's top spacing moved up to .cat-scope: left on this element
          it would have travelled with it and parked a 3rem gap of paper above
          the pills once stuck. */}
      {/* The sentinel is what tells us the bar has stuck: it sits one pixel
          above the sticky element in normal flow, so the moment it passes
          under the header the bar is at its stop. Observing the bar itself
          would never fire — a stuck element stays in view by definition. */}
      <div class="cat-sentinel" aria-hidden="true"></div>
      <div class="cat-bar sticky top-16 z-40 bg-paper py-4 sm:py-5">
      <section class="max-w-[720px] mx-auto px-6">
        <fieldset class="flex flex-wrap items-center gap-2.5 animate-reveal delay-3">
          <legend class="sr-only">카테고리로 글 고르기</legend>

          <input
            type="radio"
            name="category"
            id="cat-0"
            class="cat-input sr-only"
            checked
          />
          <label for="cat-0" class="cat-pill">전체</label>

          {
            usedCategories.map((c, i) => (
              <>
                <input
                  type="radio"
                  name="category"
                  id={`cat-${i + 1}`}
                  class="cat-input sr-only"
                />
                <label for={`cat-${i + 1}`} class="cat-pill">
                  {c}
                </label>
              </>
            ))
          }
        </fieldset>
      </section>
      </div>

      {/* Same idiom as the hero script below: inline, dependency-free, not a
          hydrated component (see the islands policy in CLAUDE.md). There is no
          CSS selector for "is currently stuck", so this is the one job that
          needs script. If it never runs the bar still sticks — it just does
          not gain the shadow. */}
      <script is:inline>
        ;(() => {
          const bar = document.querySelector('.cat-bar')
          const sentinel = document.querySelector('.cat-sentinel')
          if (!bar || !sentinel || !('IntersectionObserver' in window)) return
          new IntersectionObserver(
            ([entry]) => bar.classList.toggle('is-stuck', !entry.isIntersecting),
            // The header is 64px of fixed chrome over the viewport; shrink the
            // root by that much so the sentinel counts as gone when it slides
            // under the header, not when it leaves the screen entirely.
            { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
          ).observe(sentinel)
        })()
      </script>

      {/* flex + gap, not space-y: a card the filter hides is display:none, and
          gap collapses around it where a sibling margin would leave a hole. */}
      <section class="max-w-[720px] mx-auto px-6 pt-4 pb-20 flex flex-col gap-5 sm:gap-6">
        {articles.map((article, i) => <ArticleCard article={article} index={i} />)}
      </section>
    </div>
  </div>
</Base>
