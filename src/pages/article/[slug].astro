---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import ArticleView from '../../components/ArticleView.astro'
import { articles, langsForSlug } from '../../data/articles'
import { localizeArticle } from '../../data/articleTypes'
import { ROOT_LOCALE } from '../../lib/i18n'
import { t } from '../../lib/strings'

export const getStaticPaths = (async () => {
  return Promise.all(
    articles.map(async (article) => {
      // Every post has a Korean base copy, so localizeArticle never returns
      // null here — the non-null assertion is the type system catching up.
      const localized = localizeArticle(article, ROOT_LOCALE.lang)!
      return {
        params: { slug: article.slug },
        // Read the body at build time. loadContent() keeps its interface; it
        // just runs in Node during the build instead of in the browser.
        props: { article: localized, content: await localized.loadContent() },
      }
    }),
  )
}) satisfies GetStaticPaths

const { article, content } = Astro.props
const locale = ROOT_LOCALE
const strings = t(locale.lang)
---

<Base
  locale={locale}
  title={`${article.title} — ${strings.siteTitle}`}
  description={article.subtitle}
  availableLangs={langsForSlug(article.slug)}
>
  <ArticleView locale={locale} article={article} content={content} />
</Base>
