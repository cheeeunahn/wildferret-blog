---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import ArticleView from '../../components/ArticleView.astro'
import { articlesIn, langsForSlug } from '../../content/service'
import { ROOT_LOCALE } from '../../shared/i18n'
import { t } from '../../copy/strings'

export const getStaticPaths = (async () => {
  return Promise.all(
    // Every post has a Korean base copy, so the Korean index is every post.
    articlesIn(ROOT_LOCALE.lang).map(async (article) => ({
      params: { slug: article.slug },
      // Read the body at build time. loadContent() keeps its interface; it
      // just runs in Node during the build instead of in the browser.
      props: { article, content: await article.loadContent() },
    })),
  )
}) satisfies GetStaticPaths

const { article, content } = Astro.props
const locale = ROOT_LOCALE
const strings = t(locale.lang)
---

<Base
  locale={locale}
  title={`${article.title} — ${strings.siteTitle}`}
  description={article.subtitle}
  availableLangs={langsForSlug(article.slug)}
>
  <ArticleView locale={locale} article={article} content={content} />
</Base>
