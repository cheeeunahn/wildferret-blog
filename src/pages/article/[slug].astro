---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import { articles } from '../../data/articles'
import { getDiagram } from '../../components/diagramRegistry'
import {
  formatInline,
  parseImageLine,
  splitContentIntoBlocks,
} from '../../lib/articleContent'
import { resolveAssetUrl } from '../../lib/assetUrl'
import { href } from '../../lib/siteUrl'

export const getStaticPaths = (async () => {
  return Promise.all(
    articles.map(async (article) => ({
      params: { slug: article.slug },
      // Read the body at build time. loadContent() keeps its interface; it just
      // runs in Node during the build instead of in the browser after mount.
      props: { article, content: await article.loadContent() },
    })),
  )
}) satisfies GetStaticPaths

const { article, content } = Astro.props
const allBlocks = splitContentIntoBlocks(content)

// A leading summary heading plus its bullet list renders as a card at the top of
// the body instead of a plain heading + list. The heading text becomes the card
// label, so renaming it in the content (TL;DR → 핵심 요약) keeps working. The
// divider that follows it in the source is dropped — the card's border separates it.
const summaryHeading = allBlocks[0]?.trim().match(/^##\s+(.+)$/)?.[1]?.trim()
const isSummaryLabel = (label?: string) =>
  !!label && (/^tl[;,.]?\s?dr$/i.test(label) || label.includes('요약'))

const hasSummary =
  isSummaryLabel(summaryHeading) && !!allBlocks[1]?.trim().startsWith('- ')

const summaryLabel = hasSummary ? summaryHeading! : ''
const summaryItems = hasSummary
  ? allBlocks[1]
      .trim()
      .split('\n')
      .filter((l) => l.trim().startsWith('- '))
      .map((l) => l.replace(/^-\s+/, ''))
  : []

let blocks = hasSummary ? allBlocks.slice(2) : allBlocks
if (hasSummary && blocks[0]?.trim() === '---') blocks = blocks.slice(1)

const langLabels: Record<string, string> = {
  bash: 'Terminal',
  json: 'JSON',
  js: 'JavaScript',
  ts: 'TypeScript',
}

const delay = (i: number) => `animation-delay: ${i * 0.05}s`
const MAX_CAROUSEL_SLIDES = 6
---

<Base
  title={`${article.title} — wildferret의 블로그`}
  description={article.subtitle}
>
  <div class="page-enter">
    {/* Article Header */}
    <header class="max-w-[720px] mx-auto px-6 pt-10 sm:pt-14 pb-8">
      <div class="animate-reveal">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-5">
          <span class="text-xs text-ink-500">{article.date}</span>
          <span class="w-px h-3 bg-ink-200"></span>
          <span class="text-xs text-ink-500">{article.readTime} 읽기</span>
        </div>

        <h1
          class="text-[28px] sm:text-[36px] font-bold text-ink-950 leading-tight tracking-tight mb-3"
        >
          {article.title}
        </h1>
        <p class="text-ink-600 text-base leading-relaxed">{article.subtitle}</p>
        {
          article.coverImage && (
            <div class="mt-8">
              <div class="overflow-hidden rounded-2xl border border-ink-100">
                <img
                  src={resolveAssetUrl(article.coverImage)}
                  alt={article.title}
                  class="w-full h-auto object-cover"
                  loading="eager"
                />
              </div>
              <p class="mt-3 text-sm text-ink-600 leading-relaxed">
                해당 이미지는 AI로 제작한, 이해를 돕기 위한 예시 이미지입니다.
              </p>
            </div>
          )
        }
      </div>
    </header>

    <hr class="ink-divider max-w-[720px] mx-auto" />

    {/* Article Body */}
    <article class="max-w-[720px] mx-auto px-6 pt-9 pb-12 prose-blog">
      {
        summaryItems.length > 0 && (
          <aside
            class="mb-10 rounded-xl border border-ink-100 overflow-hidden animate-reveal"
            aria-label={summaryLabel}
          >
            <div
              class="px-4 py-2 border-b border-ink-100 bg-ink-50/60 text-[13px] text-ink-600"
            >
              {summaryLabel}
            </div>
            <div class="px-5 py-4">
              <ul
                class="list-disc pl-5 space-y-2.5 marker:text-ink-300 text-ink-700 text-[15px] leading-relaxed"
              >
                {summaryItems.map((item) => (
                  <li set:html={formatInline(item)} />
                ))}
              </ul>
            </div>
          </aside>
        )
      }
      {
        blocks.map((block, i) => {
          const trimmed = block.trim()

          if (trimmed === '---') {
            return <hr class="ink-divider my-10" />
          }

          const diagramMatch = trimmed.match(/^\[diagram:(.+)\]$/)
          if (diagramMatch) {
            const Diagram = getDiagram(diagramMatch[1])
            // No client:* directive → server-rendered to static HTML, zero JS.
            if (Diagram) {
              return (
                <div class="animate-reveal" style={delay(i)}>
                  <Diagram />
                </div>
              )
            }
          }

          if (trimmed.startsWith('~~~')) {
            const codeLines = trimmed.split('\n')
            const langMatch = codeLines[0].match(/^~~~(\w+)?$/)
            const lang = langMatch?.[1] || ''
            const code = codeLines.slice(1, codeLines.length - 1).join('\n')
            const label = langLabels[lang] || (lang ? lang : '')
            return (
              <div
                class="my-6 rounded-xl border border-ink-100 overflow-hidden animate-reveal"
                style={delay(i)}
              >
                <div
                  class="flex items-center gap-1.5 px-4 py-2 border-b border-ink-100 bg-ink-50/60"
                >
                  <div
                    class="w-[7px] h-[7px] rounded-full border border-ink-300/70"
                  />
                  <div
                    class="w-[7px] h-[7px] rounded-full border border-ink-300/70"
                  />
                  <div
                    class="w-[7px] h-[7px] rounded-full border border-ink-300/70"
                  />
                  {label && (
                    <span class="ml-2 text-[11px] text-ink-600">{label}</span>
                  )}
                </div>
                <pre
                  class="px-4 py-3 bg-paper-warm/40 overflow-x-auto"
                ><code class="text-[13px] text-ink-600 leading-relaxed whitespace-pre block font-mono">{code}</code></pre>
              </div>
            )
          }

          if (trimmed.startsWith('### ')) {
            return (
              <h3
                class="text-lg font-semibold text-ink-900 mt-8 mb-4 animate-reveal"
                style={delay(i)}
              >
                {trimmed.replace('### ', '')}
              </h3>
            )
          }

          if (trimmed.startsWith('## ')) {
            return (
              <h2 class="animate-reveal" style={delay(i)}>
                {trimmed.replace('## ', '')}
              </h2>
            )
          }

          if (trimmed.startsWith('> ')) {
            return (
              <blockquote
                class="animate-reveal"
                style={delay(i)}
                set:html={formatInline(
                  trimmed.replace('> ', '').replace(/^"/, '').replace(/"$/, ''),
                )}
              />
            )
          }

          if (trimmed.startsWith('- ')) {
            const items = trimmed
              .split('\n')
              .filter((l) => l.trim().startsWith('- '))
              .map((l) => l.replace(/^-\s+/, ''))
            return (
              <ul
                class="list-disc pl-5 mb-6 space-y-2 text-ink-700 text-[17px] leading-relaxed animate-reveal"
                style={delay(i)}
              >
                {items.map((item) => (
                  <li set:html={formatInline(item)} />
                ))}
              </ul>
            )
          }

          if (trimmed.match(/^\d\.\s/)) {
            const items = trimmed
              .split('\n')
              .map((line) => line.replace(/^\d+\.\s/, ''))
            return (
              <ol
                class="list-decimal pl-5 mb-6 space-y-2 text-ink-700 text-[17px] leading-relaxed animate-reveal"
                style={delay(i)}
              >
                {items.map((item) => (
                  <li set:html={formatInline(item)} />
                ))}
              </ol>
            )
          }

          if (
            trimmed.includes('\n') &&
            trimmed
              .split('\n')
              .every((l) => l.trim().startsWith('|') && l.trim().endsWith('|'))
          ) {
            const rows = trimmed.split('\n').map((l) => l.trim())
            const dataRows = rows.filter((r) => !r.match(/^\|[\s\-:|]+\|$/))
            const headerCells = dataRows[0]
              .split('|')
              .filter((c) => c.trim())
              .map((c) => c.trim())
            const bodyRows = dataRows
              .slice(1)
              .map((r) =>
                r
                  .split('|')
                  .filter((c) => c.trim() !== '')
                  .map((c) => c.trim()),
              )
            return (
              <div
                class="my-6 overflow-x-auto rounded-xl border border-ink-100 animate-reveal"
                style={delay(i)}
              >
                <table class="w-full min-w-[560px] text-[15px]">
                  <thead>
                    <tr class="border-b border-ink-100 bg-ink-50/60">
                      {headerCells.map((cell) => (
                        <th
                          class="px-4 py-2.5 text-left text-xs font-semibold text-ink-500 uppercase tracking-wide"
                        >
                          {cell}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {bodyRows.map((cells, j) => (
                      <tr
                        class={j < bodyRows.length - 1 ? 'border-b border-ink-50' : ''}
                      >
                        {cells.map((cell) => (
                          <td
                            class="px-4 py-2.5 text-ink-700 leading-relaxed"
                            set:html={formatInline(cell)}
                          />
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }

          // Consecutive image lines in one block (no blank line between them) are
          // one carousel sharing a single caption, taken from the first line.
          // Scroll-snap only — no client JS, per the islands policy.
          const imageLines = trimmed.split('\n').map((l) => l.trim())
          if (
            imageLines.length > 1 &&
            imageLines.every((l) => parseImageLine(l) !== null)
          ) {
            const slides = imageLines.map((l) => parseImageLine(l)!)
            if (slides.length > MAX_CAROUSEL_SLIDES) {
              throw new Error(
                `Carousel in ${article.slug} has ${slides.length} images; only up to ${MAX_CAROUSEL_SLIDES} are supported`,
              )
            }
            const caption = slides.find((s) => s.caption)?.caption
            const cid = `carousel-${i}`
            return (
              <figure class="carousel my-8 animate-reveal" style={delay(i)}>
                {slides.map((_, n) => (
                  <input
                    type="radio"
                    name={cid}
                    id={`${cid}-${n}`}
                    class="carousel-input sr-only"
                    checked={n === 0}
                    aria-label={`${n + 1}번째 이미지`}
                  />
                ))}
                <div
                  class="overflow-hidden rounded-2xl border border-ink-100 bg-ink-50/40"
                >
                  <div class="carousel-track flex">
                    {slides.map((slide, n) => (
                      <div class="relative w-full shrink-0">
                        <img
                          src={resolveAssetUrl(slide.src)}
                          alt={slide.alt || article.title}
                          class="h-[240px] sm:h-[320px] w-full object-contain"
                          loading={n === 0 ? 'eager' : 'lazy'}
                        />
                        {n > 0 && (
                          <label
                            for={`${cid}-${n - 1}`}
                            class="carousel-arrow carousel-arrow-prev"
                            aria-hidden="true"
                          >
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <polyline points="15 18 9 12 15 6" />
                            </svg>
                          </label>
                        )}
                        {n < slides.length - 1 && (
                          <label
                            for={`${cid}-${n + 1}`}
                            class="carousel-arrow carousel-arrow-next"
                            aria-hidden="true"
                          >
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <polyline points="9 6 15 12 9 18" />
                            </svg>
                          </label>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
                <div class="carousel-dots mt-3 flex items-center justify-center gap-2">
                  {slides.map((_, n) => (
                    <label
                      for={`${cid}-${n}`}
                      class="carousel-dot"
                      aria-hidden="true"
                    />
                  ))}
                </div>
                {caption && (
                  <figcaption
                    class="mt-2 text-center text-sm text-ink-600 leading-relaxed"
                    set:html={formatInline(caption)}
                  />
                )}
              </figure>
            )
          }

          const image = parseImageLine(trimmed)
          if (image) {
            return (
              <figure class="my-8 animate-reveal" style={delay(i)}>
                <div class="overflow-hidden rounded-2xl border border-ink-100">
                  <img
                    src={resolveAssetUrl(image.src)}
                    alt={image.alt || article.title}
                    class="w-full h-auto object-cover"
                    loading="lazy"
                  />
                </div>
                {image.caption && (
                  <figcaption
                    class="mt-3 text-sm text-ink-600 leading-relaxed"
                    set:html={formatInline(image.caption)}
                  />
                )}
              </figure>
            )
          }

          return (
            <p
              class="animate-reveal"
              style={delay(i)}
              set:html={formatInline(trimmed)}
            />
          )
        })
      }
    </article>

    {/* Back link */}
    <div class="max-w-[720px] mx-auto px-6 pb-20">
      <hr class="ink-divider mb-10" />
      <a
        href={href('/')}
        class="inline-flex items-center gap-2 text-sm text-ink-600 no-underline hover:text-ink-700 transition-colors"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        목록으로 돌아가기
      </a>
    </div>
  </div>
</Base>
