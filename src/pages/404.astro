---
// One prerendered 404.html serves every miss, /en/ included (see
// not_found_handling in wrangler.jsonc), so this page cannot know the reader's
// language at build time. It answers in both rather than guessing — and needs
// no script to do it.
import Base from '../layouts/Base.astro'
import { LANGS, ROOT_LOCALE, switchLangHref } from '../lib/i18n'
import { t } from '../lib/strings'

const options = LANGS.map((lang) => ({
  lang,
  strings: t(lang),
  home: switchLangHref(lang, '/'),
}))
---

<Base
  locale={ROOT_LOCALE}
  title={`${t('ko').notFound.title} · ${t('en').notFound.title}`}
  availableLangs={[]}
>
  <div class="max-w-[720px] mx-auto px-6 py-32 text-center page-enter">
    {
      options.map(({ lang, strings, home }, i) => (
        <div class={i > 0 ? 'mt-10' : ''} lang={lang}>
          <h1 class="text-2xl font-semibold text-ink-900 mb-4">
            {strings.notFound.title}
          </h1>
          <a
            href={home}
            class="text-ink-600 hover:text-ink-700 text-sm underline underline-offset-4"
          >
            {strings.notFound.back}
          </a>
        </div>
      ))
    }
  </div>
</Base>
