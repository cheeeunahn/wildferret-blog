---
import Base from '../layouts/Base.astro'
import { href } from '../lib/siteUrl'
---

<Base title="페이지를 찾을 수 없습니다 — wildferret의 블로그">
  <div class="max-w-[720px] mx-auto px-6 py-32 text-center page-enter">
    <h1 class="text-2xl font-semibold text-ink-900 mb-4">
      페이지를 찾을 수 없습니다
    </h1>
    <a
      href={href('/')}
      class="text-ink-600 hover:text-ink-700 text-sm underline underline-offset-4"
    >
      목록으로 돌아가기
    </a>
  </div>
</Base>
