---
import Base from '../layouts/Base.astro'
import { resolveAssetUrl } from '../lib/assetUrl'

const profileImageUrl = resolveAssetUrl('/assets/images/profile-ferret-desk.webp')

const interests = [
  'Product Management',
  'User Research',
  'AI',
  'Data Analysis',
]

const career = [
  { period: '2024 — 현재', role: 'UX Researcher → Product Manager', org: '세금 도메인' },
  { period: '2022 — 2024', role: 'UX Researcher', org: '인테리어 및 커머스 도메인' },
  { period: '2022', role: 'UX Researcher', org: '슬립테크 스타트업' },
  { period: '2014 — 2022', role: '산업디자인 학·석사 (HCI)', org: '공과대학' },
]

/*const skills = [
  { label: '유저 리서치', items: '사용자 인터뷰 · 설문 설계 · 사용성 테스트 · 리서치 시스템 구축' },
  { label: '데이터 분석', items: 'Databrick · Amplitude · A/B 테스트 · 이벤트 로그 설계' },
  { label: '자격증', items: '빅데이터분석기사 · ADsP · SQLD · 세무회계 3급' },
]*/
---

<Base
  title="소개 — wildferret의 블로그"
  description="사람을 깊이 이해하고, 조용하지만 분명한 차이를 만드는 제품을 만듭니다."
>
  <div class="page-enter">
    <section class="max-w-[640px] mx-auto px-6 pt-10 sm:pt-14 pb-20">
      {/* Profile */}
      <div class="animate-reveal mb-12">
        <div
          class="w-20 h-20 rounded-full border border-ink-200 overflow-hidden mb-6"
        >
          <img
            src={profileImageUrl}
            alt="wildferret 프로필 이미지"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <h1
          class="text-2xl sm:text-3xl font-bold text-ink-950 tracking-tight mb-3"
        >
          안녕하세요, wildferret입니다
        </h1>
        <p class="text-ink-600 text-[15px]">
          사람을 깊이 이해하고, 조용하지만 분명한 차이를 만드는 제품을 만듭니다.
        </p>
      </div>

      {/* Interests */}
      <div class="animate-reveal delay-2">
        <h2
          class="text-sm font-medium text-ink-600 uppercase tracking-widest mb-6"
        >
          관심사
        </h2>
        <p class="text-ink-700 text-[15px]">
          {interests.join(' · ')}
        </p>
      </div>

      {/* Career */}
      <div class="mt-16 animate-reveal delay-3">
        <h2
          class="text-sm font-medium text-ink-600 uppercase tracking-widest mb-6"
        >
          경력
        </h2>
        <ul class="space-y-3">
          {
            career.map((item) => (
              <li class="flex flex-col sm:flex-row sm:gap-4 text-[15px]">
                <span
                  class="text-ink-600 text-xs sm:text-[13px] sm:w-32 sm:shrink-0 sm:pt-1 tabular-nums"
                >
                  {item.period}
                </span>
                <span class="text-ink-700">
                  {item.role}
                  <span class="text-ink-600">{` · ${item.org}`}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>



    </section>
  </div>
</Base>
