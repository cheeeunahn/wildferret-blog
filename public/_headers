# Served by Cloudflare's static-asset runtime. Copied to dist/client/ at build.
#
# script-src allows 'unsafe-inline' because Astro emits its island hydration
# runtime as inline <script> blocks whose content changes per page and per
# build, alongside the pre-paint theme script in Base.astro. Hashing them is not
# maintainable, and a nonce needs a server this site does not have.
#
# Be clear about what that costs: this CSP is NOT a backstop against script
# injection. The defense against injected markup (the AI summary renders model
# output) is React escaping JSX children, enforced by
# local/no-unescaped-user-html — not this header. What the header still buys is
# real but narrower:
#   connect-src   an injected script cannot exfiltrate to an arbitrary host —
#                 only same-origin requests
#   object-src    no <object>/<embed> vector
#   base-uri      no <base> tag hijacking every relative URL on the page
#   frame-ancestors  no clickjacking
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://hangeul.pstatic.net https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
