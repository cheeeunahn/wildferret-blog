{
  "name": "wildferret-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "translation:status": "node scripts/translation-status.mjs",
    "translate": "claude \"/translate-articles\"",
    "mint:api-jwt": "node scripts/mint-api-jwt.mjs",
    "sbom": "node scripts/sbom.mjs",
    "docs:status": "node scripts/docs-sync.mjs",
    "docs:write": "node scripts/docs-sync.mjs --write",
    "docs:sync": "claude \"/sync-docs\"",
    "astro": "astro",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "pnpm astryx theme build src/styles/astryx/wildferretTheme.ts --out src/styles/astryx/wildferret.theme.css",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/react": "7.1.2",
    "@astryxdesign/core": "0.6.5",
    "@stylexjs/stylex": "0.19.1",
    "astro": "7.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astryxdesign/cli": "0.6.5",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-chromium-ai": "^0.0.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
