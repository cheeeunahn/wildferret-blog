# Supabase — comments. Copy to .env and fill in.
#
# These are PUBLIC_ vars: Astro inlines them into the built JS at BUILD time,
# not runtime. They must be present wherever `pnpm build` runs (locally, and as
# build environment variables in the Cloudflare build config) — setting them as
# Worker runtime secrets does nothing.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the publishable / anon key (sb_publishable_… or the legacy anon JWT).
# NEVER the service_role key — it bypasses row level security entirely.
PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
